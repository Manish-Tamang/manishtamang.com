# Environment variables for manishtamang.com (Astro).
# Copy to .env for local development; on Vercel add them under
# Project Settings > Environment Variables. Everything is optional to the
# build: a missing value turns that feature off instead of failing.

# Site auth (guestbook sign-in) ------------------------------------------------
# Postgres connection string from Supabase (the pooler, port 6543)
DATABASE_URL=
# Reuse the old site's value so signed-in sessions carry over
BETTER_AUTH_SECRET=
# http://localhost:4321 locally, https://manishtamang.com in production
BETTER_AUTH_URL=https://manishtamang.com
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signing up with this email makes the account an admin
ADMIN_EMAIL=

# Supabase (blog views, guestbook) ---------------------------------------------
SUPABASE_URL=
# Server only: never expose this one
SUPABASE_SERVICE_ROLE_KEY=
# Browser side, for guestbook image uploads
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Resend (guestbook emails) ----------------------------------------------------
RESEND_API_KEY=

# Last.fm (now playing) --------------------------------------------------------
LASTFM_API_KEY=
LASTFM_USERNAME=

# Umami (dashboard traffic) ----------------------------------------------------
# Self-hosted: UMAMI_USERNAME + UMAMI_PASSWORD. Umami Cloud: UMAMI_API_KEY.
UMAMI_API_URL=https://analytics.manishtamang.com/api
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
WEBSITE_ID=

# WakaTime (dashboard coding stats) --------------------------------------------
WAKATIME_ACCESS_TOKEN=
WAKATIME_CLIENT_ID=
WAKATIME_CLIENT_SECRET=
# Must match the URL registered with WakaTime
WAKATIME_REDIRECT_URI=https://manishtamang.com/api/wakatime/callback

# daily.dev (dashboard bookmarks) ----------------------------------------------
DAILY_API_KEY=

# Contact page -----------------------------------------------------------------
PUBLIC_WEB3FORMS_ACCESS_KEY=
PUBLIC_CALENDLY_URL=

