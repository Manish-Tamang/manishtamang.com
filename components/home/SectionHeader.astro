---
import ArrowRight from "@/components/icons/ArrowRight.astro"

export interface Props {
  title: string
  href?: string
  linkLabel?: string
}

const { title, href, linkLabel } = Astro.props
---

<header class="mb-6">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-base font-subsection text-heading">{title}</h2>
    {href && (
      <a
        href={href}
        class="inline-flex shrink-0 items-center gap-1 text-sm text-link decoration-current/35 decoration-1 underline-offset-[0.2em] transition-colors hover:text-link-hover hover:underline"
      >
        {linkLabel}
        <ArrowRight class="size-3.5" />
      </a>
    )}
  </div>
  {Astro.slots.has("default") && (
    <p class="mt-1 text-sm text-foreground">
      <slot />
    </p>
  )}
</header>
