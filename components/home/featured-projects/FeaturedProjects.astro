---
import type { ImageMetadata } from "astro"
import BlurImage from "@/components/ui/BlurImage.astro"
import SectionHeader from "@/components/home/SectionHeader.astro"
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import { featuredProjects } from "@/data/home"

const images = import.meta.glob<{ default: ImageMetadata }>("/assets/projects/*", { eager: true })

const truncateWords = (text: string, maxWords: number) => {
  const words = text.trim().split(/\s+/)
  return words.length <= maxWords ? text : `${words.slice(0, maxWords).join(" ").replace(/[,.;:]$/, "")}…`
}
---

<section>
  <SectionHeader title="Featured projects" href="/projects" linkLabel="All projects" />
  <ul class="space-y-6">
    {featuredProjects.map(({ title, tagline, excerpt, link, image }) => (
      <li>
        <a href={link} target="_blank" rel="noopener noreferrer" class="group flex flex-col gap-4 md:flex-row md:items-start md:gap-5">
          <BlurImage
            src={images[`/assets/projects/${image}`].default}
            alt={title}
            widths={[180, 360, 720]}
            sizes="(min-width: 768px) 180px, 100vw"
            quality={75}
            class="aspect-video w-full shrink-0 rounded-md bg-muted object-cover md:h-[110px] md:w-[180px] md:aspect-auto"
          />
          <div class="min-w-0 flex-1 text-sm">
            <p class="font-subsection text-heading transition-colors group-hover:text-link-hover">{title}</p>
            <p class="text-muted-foreground">{tagline}</p>
            <p class="mt-2 line-clamp-2">{truncateWords(excerpt, 18)}</p>
            <span class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
              <span class="truncate">{link.replace(/^https?:\/\//, "")}</span>
              <ArrowUpRight class="size-3 shrink-0 opacity-0 transition-opacity group-hover:opacity-100" />
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
