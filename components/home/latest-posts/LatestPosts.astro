---
import SectionHeader from "@/components/home/SectionHeader.astro"
import BlogCard from "./BlogCard.astro"
import MobileBlogItem from "./MobileBlogItem.astro"
import { getPosts } from "@/lib/blog"

const posts = (await getPosts()).slice(0, 3)
---

<section>
  <SectionHeader title="Latest from the blog" href="/blog" linkLabel="All posts" />

  <!-- Cards run past the bottom edge; hovering one lifts it clear -->
  <div class="relative hidden h-[310px] flex-row items-end justify-center gap-2 [clip-path:inset(-4rem_-4rem_0_-4rem)] md:flex">
    {posts.map((post, index) => (
      <div class="-mb-12 flex min-w-0 flex-1 justify-center">
        <BlogCard post={post} index={index} />
      </div>
    ))}
  </div>

  <div class="flex flex-col gap-4 md:hidden">
    {posts.map((post) => <MobileBlogItem post={post} />)}
  </div>
</section>
