---
import { Image } from "astro:assets"
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import { formatDate, type Post } from "@/lib/blog"

export interface Props {
  post: Post
}

const { id, data } = Astro.props.post
---

<a href={`/blog/${id}`} class="group flex items-center gap-4 rounded-xl bg-foreground/5 p-2 transition-colors hover:bg-foreground/8">
  <div class="h-16 w-[100px] shrink-0 overflow-hidden rounded-lg border border-border bg-muted">
    {data.cover ? (
      <Image src={data.cover} alt={data.title} width={200} quality={70} class="size-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0" />
    ) : (
      <div class="flex size-full items-center justify-center text-xs text-muted-foreground">No image</div>
    )}
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <h3 class="truncate text-sm font-subsection text-heading">{data.title}</h3>
      <ArrowUpRight class="size-3 shrink-0 text-muted-foreground" />
    </div>
    <p class="line-clamp-1 text-xs text-muted-foreground">{data.description}</p>
    <time datetime={data.date.toISOString()} class="block text-xs text-muted-foreground tabular-nums">{formatDate(data.date, { month: "short", day: "numeric" })}</time>
  </div>
</a>
