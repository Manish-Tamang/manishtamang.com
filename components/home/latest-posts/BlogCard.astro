---
import { Image } from "astro:assets"
import GitHub from "@/components/icons/GitHub.astro"
import { formatDate, type Post } from "@/lib/blog"

export interface Props {
  post: Post
  index: number
}

const { post, index } = Astro.props
const { id, data } = post

const rotations = ["-rotate-3", "rotate-1", "rotate-3"]
---

<a
  href={`/blog/${id}`}
  class:list={[
    "group relative flex h-[340px] w-[260px] flex-col rounded-xl border border-border/50 bg-white shadow-2xl transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] hover:z-30 hover:-translate-y-8 hover:scale-105 hover:rotate-0 dark:bg-[#1C1C1C]",
    rotations[index % rotations.length],
  ]}
>
  <div class="relative h-36 w-full overflow-hidden rounded-t-xl bg-zinc-100 dark:bg-zinc-900">
    {data.cover ? (
      <Image src={data.cover} alt={data.title} widths={[260, 520]} sizes="260px" quality={75} class="size-full object-cover transition-transform duration-500 group-hover:scale-110" />
    ) : (
      <div class="flex size-full items-center justify-center">
        <GitHub class="size-8 text-zinc-400/20" />
      </div>
    )}
    <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
  </div>
  <div class="flex flex-1 flex-col rounded-b-xl border-t border-zinc-100 bg-white p-5 dark:border-zinc-800 dark:bg-[#1C1C1C]">
    <div class="mb-3 flex items-center justify-between">
      <span class="inline-block w-fit rounded-sm bg-zinc-100 px-2 py-1 text-[10px] font-bold tracking-widest text-zinc-500 uppercase dark:bg-zinc-800 dark:text-zinc-400">Blog</span>
      <span class="text-[10px] font-medium text-zinc-400">{formatDate(data.date, { month: "short", day: "numeric" })}</span>
    </div>
    <h3 class="mb-2 line-clamp-2 text-base leading-tight font-normal text-zinc-900 dark:text-zinc-100">{data.title}</h3>
    <p class="line-clamp-4 text-[11px] leading-snug text-zinc-500 opacity-70">{data.description}</p>
  </div>
</a>
