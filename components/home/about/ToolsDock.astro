---
import Cursor from "@/assets/icons/cursor.svg"
import Claude from "@/assets/icons/claude.svg"
import TypeScript from "@/assets/icons/typescript.svg"
import Nextjs from "@/assets/icons/nextjs.svg"
import Figma from "@/assets/icons/figma.svg"

const tools = [
  { name: "Cursor", Icon: Cursor },
  { name: "Claude", Icon: Claude },
  { name: "TypeScript", Icon: TypeScript },
  { name: "Next.js", Icon: Nextjs },
  { name: "Figma", Icon: Figma },
]
---

<div class="mt-6 flex justify-center">
  <ul class="dock" aria-label="My primary tools">
    {tools.map(({ name, Icon }) => (
      <li class="dock-item">
        <span class="dock-label">{name}</span>
        <span class="dock-tile">
          <Icon class="size-4 text-zinc-900" aria-label={name} role="img" />
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .dock {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --tile: 30px;
    --tile-radius: 8px;
    --pad: 5px;

    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    padding: var(--pad);
    border-radius: calc(var(--tile-radius) + var(--pad));
    background: rgb(255 255 255 / 0.94);
    border: 1px solid rgb(255 255 255 / 0.8);
    box-shadow:
      0 4px 18px rgb(0 0 0 / 0.18),
      inset 0 1px 0 #fff;
  }

  .dock-item {
    position: relative;
    width: var(--tile);
    height: var(--tile);
    margin-inline: 0;
    transition: margin 0.3s var(--ease);
    cursor: var(--cursor-hand);
  }

  .dock-tile {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border-radius: var(--tile-radius);
    background: rgb(0 0 0 / 0.05);
    transform-origin: bottom center;
    transition: transform 0.3s var(--ease);
  }

  .dock-item:hover {
    margin-inline: 5px;
  }
  .dock-item:hover .dock-tile {
    transform: translateY(-6px) scale(1.35);
  }

  .dock-item:hover + .dock-item,
  .dock-item:has(+ .dock-item:hover) {
    margin-inline: 2px;
  }
  .dock-item:hover + .dock-item .dock-tile,
  .dock-item:has(+ .dock-item:hover) .dock-tile {
    transform: translateY(-3px) scale(1.15);
  }

  .dock-item:hover + .dock-item + .dock-item,
  .dock-item:has(+ .dock-item + .dock-item:hover) {
    margin-inline: 1px;
  }
  .dock-item:hover + .dock-item + .dock-item .dock-tile,
  .dock-item:has(+ .dock-item + .dock-item:hover) .dock-tile {
    transform: translateY(-1px) scale(1.05);
  }

  .dock-label {
    position: absolute;
    bottom: calc(100% + 22px);
    left: 50%;
    transform: translate(-50%, 4px);
    white-space: nowrap;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.85);
    padding: 3px 7px;
    font-size: 11px;
    line-height: 1.2;
    color: #fff;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease);
  }

  .dock-item:hover .dock-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-item,
    .dock-tile,
    .dock-label {
      transition: opacity 0.2s ease;
    }
  }
</style>
