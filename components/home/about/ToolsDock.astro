---
/* macOS-style dock of the tools I use most; the hover magnification is pure CSS. */
import Cursor from "@/assets/icons/cursor.svg"
import Claude from "@/assets/icons/claude.svg"
import TypeScript from "@/assets/icons/typescript.svg"
import Nextjs from "@/assets/icons/nextjs.svg"
import Figma from "@/assets/icons/figma.svg"

const tools = [
  { name: "Cursor", Icon: Cursor },
  { name: "Claude", Icon: Claude },
  { name: "TypeScript", Icon: TypeScript },
  { name: "Next.js", Icon: Nextjs },
  { name: "Figma", Icon: Figma },
]
---

<div class="mt-6 flex justify-center">
  <ul class="dock" aria-label="My primary tools">
    {tools.map(({ name, Icon }) => (
      <li class="dock-item">
        <span class="dock-label">{name}</span>
        <Icon class="size-4 text-zinc-900" aria-label={name} role="img" />
      </li>
    ))}
  </ul>
</div>

<style>
  .dock {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    padding: 5px 6px 6px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.94);
    border: 1px solid rgb(255 255 255 / 0.8);
    box-shadow:
      0 4px 18px rgb(0 0 0 / 0.18),
      inset 0 1px 0 #fff;
  }

  .dock-item {
    position: relative;
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgb(0 0 0 / 0.04);
    transform-origin: bottom center;
    transition: transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1);
    cursor:
      url("/cursor/mac-cursor.png") 10 10,
      pointer;
  }

  .dock-item:hover {
    z-index: 2;
    transform: scale(1.3) translateY(-5px);
  }

  .dock-item:hover + .dock-item,
  .dock-item:has(+ .dock-item:hover) {
    transform: scale(1.1) translateY(-2px);
  }

  .dock-label {
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    border-radius: 5px;
    background: rgb(0 0 0 / 0.85);
    padding: 3px 7px;
    font-size: 11px;
    line-height: 1.2;
    color: #fff;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .dock-item:hover .dock-label {
    opacity: 1;
  }
</style>
