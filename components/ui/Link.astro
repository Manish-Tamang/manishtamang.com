---
import type { HTMLAttributes } from "astro/types"

export interface Props extends HTMLAttributes<"a"> {
  href: string
  /** "inline" for links inside text, "nav" for standalone muted links. */
  variant?: "inline" | "nav"
}

const { href, variant = "inline", class: className, ...rest } = Astro.props

const external = /^https?:\/\//.test(href) && !href.startsWith("https://manishtamang.com")

// As on abhisekmishra.com: the underline arrives (or, in dark mode, fills in) on hover
// in a faint tint of the text colour, sitting 0.2em below the baseline
const variants = {
  inline:
    "text-link decoration-current/35 decoration-1 underline-offset-[0.2em] hover:underline hover:text-link-hover dark:underline dark:hover:decoration-current",
  nav: "text-muted-foreground decoration-current/35 decoration-1 underline-offset-[0.2em] hover:text-heading hover:underline",
}
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={["transition-[color,text-decoration-color] duration-200", variants[variant], className]}
  {...rest}
>
  <slot />{external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
