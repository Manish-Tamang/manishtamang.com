---
/*
 * The site's video player: Video.js (v10) with its neutral skin, the player
 * Mux recommends. Plays MP4 URLs (Vercel Blob), or YouTube with `youtube`
 * (src is a video id or URL; it embeds from youtube-nocookie.com).
 *
 * The box keeps its shape from `ratio` before anything loads; set its width
 * with `class`. Video.js is fetched as the player nears the screen. Players
 * that live in a dialog pass `deferred` and call loadVideoJs() on open,
 * setting src and poster themselves (lib/client/video-player.ts).
 */
import type { HTMLAttributes } from "astro/types"
import type { ImageMetadata } from "astro"
import { getImage } from "astro:assets"

export interface Props extends HTMLAttributes<"div"> {
  src?: string
  poster?: ImageMetadata | string
  /** Read out by screen readers. */
  title?: string
  /** Width / height. */
  ratio?: number
  youtube?: boolean
  deferred?: boolean
}

const { src, poster, title, ratio = 16 / 9, youtube = false, deferred = false, class: className, style, ...rest } = Astro.props

const posterUrl =
  typeof poster === "string" ? poster : poster ? (await getImage({ src: poster, width: 1280, format: "webp", quality: 80 })).src : undefined

const youtubeSrc = youtube && src ? (/^[\w-]{11}$/.test(src) ? `https://www.youtube-nocookie.com/embed/${src}` : src) : undefined
---

<div
  class:list={["video-box", className]}
  style={`--ratio: ${ratio};${style ?? ""}`}
  data-video-box
  data-video-deferred={deferred || undefined}
  {...rest}
>
  <video-player poster={posterUrl}>
    <video-neutral-skin class="video-skin">
      {
        youtube ? (
          <youtube-video src={youtubeSrc} preload="none" aria-label={title} />
        ) : (
          <video src={src} playsinline preload={posterUrl ? "none" : "metadata"} aria-label={title} />
        )
      }
    </video-neutral-skin>
  </video-player>
</div>

<script>
  import { watchVideoPlayers } from "@/lib/client/video-player"
  watchVideoPlayers()
</script>

<style is:global>
  .video-box {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #000;
  }

  .video-skin {
    display: block;
    width: 100%;
    height: 100%;
    --media-accent-color: #fff;
    --media-accent-text-color: #000;
    --media-border-color: transparent;
    --media-border-radius: var(--radius-lg);
    --media-font-family: var(--font-sans);
  }

  .video-skin > video,
  .video-skin > youtube-video {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
