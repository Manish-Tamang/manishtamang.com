---
import type { HTMLAttributes } from "astro/types"

export type Props = HTMLAttributes<"textarea">

const { class: className, ...rest } = Astro.props
---

<textarea
  class:list={[
    "min-h-28 w-full rounded-md border border-border bg-background px-3 py-2 text-sm placeholder:text-muted-foreground field-sizing-content",
    "transition-colors hover:border-border-strong focus-visible:border-accent focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring",
    "disabled:cursor-not-allowed disabled:opacity-50",
    className,
  ]}
  {...rest}><slot /></textarea>
