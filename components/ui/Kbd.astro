---
import type { HTMLAttributes } from "astro/types"

export type Props = HTMLAttributes<"kbd">

const { class: className, ...rest } = Astro.props
---

<kbd
  class:list={[
    "inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-subtle px-1 font-mono text-[0.7rem] text-muted-foreground",
    className,
  ]}
  {...rest}><slot /></kbd>
