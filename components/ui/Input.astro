---
import type { HTMLAttributes } from "astro/types"

export type Props = HTMLAttributes<"input">

const { class: className, ...rest } = Astro.props
---

<input
  class:list={[
    "h-10 w-full rounded-md border border-border bg-background px-3 text-sm placeholder:text-muted-foreground",
    "transition-colors hover:border-border-strong focus-visible:border-accent focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring",
    "disabled:cursor-not-allowed disabled:opacity-50",
    className,
  ]}
  {...rest}
/>
