---
/*
 * Live player for /now. One of four states shows at a time: loading until the
 * first answer, then playing, last played, or empty if there's nothing to show.
 */
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
---

<section data-player data-state="loading">
  <!-- Same title style as the other sections on /now -->
  <h2 class="mb-3 flex items-center gap-2 text-sm font-subsection text-heading">
    <span data-player-heading>Listening to</span>
    <span data-player-dot hidden class="relative flex size-1.5">
      <span class="absolute inline-flex size-full animate-ping rounded-full bg-[#1DB954] opacity-75"></span>
      <span class="relative inline-flex size-1.5 rounded-full bg-[#1DB954]"></span>
    </span>
  </h2>

  <!-- A plain row like the rest of the page, no frame -->
  <div>
    <div data-player-loading class="flex animate-pulse items-center gap-3" aria-label="Loading">
      <div class="size-12 shrink-0 rounded-lg bg-muted"></div>
      <div class="flex-1 space-y-2">
        <div class="h-3 w-1/3 rounded bg-muted"></div>
        <div class="h-3 w-1/2 rounded bg-muted"></div>
      </div>
    </div>

    <a data-player-song hidden target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3">
      <img data-player-art hidden alt="" width="48" height="48" class="size-12 shrink-0 rounded-lg bg-muted object-cover" />
      <span class="min-w-0 flex-1">
        <span data-player-title class="block truncate text-sm font-medium text-heading transition-colors group-hover:text-link-hover"></span>
        <span data-player-artist class="block truncate text-xs text-muted-foreground"></span>
      </span>
      <ArrowUpRight class="size-4 shrink-0 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100" />
    </a>

    <p data-player-empty hidden class="px-1 py-2 text-sm text-muted-foreground">Nothing played recently.</p>
  </div>
</section>

<script>
  import { pollNowPlaying } from "@/lib/client/now-playing"

  const root = document.querySelector<HTMLElement>("[data-player]")

  if (root) {
    const $ = <T extends Element>(name: string) => root.querySelector<T>(`[data-player-${name}]`)!
    const song = $<HTMLAnchorElement>("song")
    const art = $<HTMLImageElement>("art")
    const loading = $<HTMLElement>("loading")
    const empty = $<HTMLElement>("empty")
    let hasSong = false

    const show = (state: "song" | "empty") => {
      root.dataset.state = state
      loading.hidden = true
      song.hidden = state !== "song"
      empty.hidden = state !== "empty"
    }

    pollNowPlaying(
      ({ title, artist, songUrl, albumImageUrl, isPlaying }) => {
        if (!title || !artist) return show(hasSong ? "song" : "empty")

        hasSong = true
        $<HTMLElement>("title").textContent = title
        $<HTMLElement>("artist").textContent = artist
        $<HTMLElement>("heading").textContent = isPlaying ? "Listening to" : "Last played"
        $<HTMLElement>("dot").hidden = !isPlaying
        song.href = songUrl ?? "https://open.spotify.com"
        art.hidden = !albumImageUrl
        if (albumImageUrl) art.src = albumImageUrl
        show("song")
      },
      // Keep the last song on a failed refresh; only an empty player says so
      () => show(hasSong ? "song" : "empty"),
    )
  }
</script>
