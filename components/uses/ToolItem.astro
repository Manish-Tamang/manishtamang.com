---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import Badge from "@/components/ui/Badge.astro"
import { slugify, type Tool } from "@/data/uses"

export type Props = Tool

const { name, note, url, tag } = Astro.props

const icons = import.meta.glob<{ default: ImageMetadata }>("/assets/uses/icons/*.png", { eager: true })
const icon = icons[`/assets/uses/icons/${slugify(name)}.png`]?.default

const Tag = url ? "a" : "div"
const formerly = tag === "Formerly"
---

<Tag
  href={url}
  target={url ? "_blank" : undefined}
  rel={url ? "noopener noreferrer" : undefined}
  class:list={["group -mx-2 flex items-center gap-3 rounded-lg px-2 py-2 transition-colors", url && "hover:bg-subtle", formerly && "opacity-60"]}
>
  <!-- White in both themes: favicons are drawn for light backgrounds -->
  <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-white">
    {
      icon ? (
        <Image src={icon} alt="" width={20} height={20} densities={[1, 2]} class="size-5 rounded-xs" />
      ) : (
        <span class="text-xs font-semibold text-muted-foreground">{name.slice(0, 2)}</span>
      )
    }
  </span>
  <span class="min-w-0">
    <span class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
      <span class:list={["text-sm font-medium text-heading", url && "group-hover:text-link-hover", formerly && "line-through"]}>{name}</span>
      {tag && <Badge variant={tag === "Primary" || tag === "Made by me" ? "accent" : "outline"}>{tag}</Badge>}
    </span>
    <span class="block truncate text-xs text-muted-foreground">{note}</span>
  </span>
</Tag>
