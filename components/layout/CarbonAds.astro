---
/*
 * Carbon ad card, fixed to the bottom right above the back-to-top button. The
 * script only loads once the footer is on screen, and the card stays hidden
 * if it never arrives (ad blockers). Needs room beside the content column,
 * so it's left out of narrower windows.
 */
---

<aside
  data-carbon
  aria-label="Advertisement"
  class="invisible fixed right-6 bottom-20 z-30 hidden w-44 translate-y-2 rounded-lg border border-border bg-background p-1 text-xs text-muted-foreground opacity-0 transition-all duration-300 data-[visible]:visible data-[visible]:translate-y-0 data-[visible]:opacity-100 min-[1360px]:block"
>
  <div data-carbon-slot></div>
  <p class="px-1 pt-1 pb-0.5 text-center">1 Click Supports this site</p>
</aside>

<style is:global>
  #carbonads {
    display: block;
    overflow: hidden;
    border-radius: 0.375rem;
    font-size: 12px;
    line-height: 1.4;
  }

  #carbonads a {
    color: inherit;
    text-decoration: none;
  }

  #carbonads a:hover {
    color: var(--heading);
  }

  #carbonads span {
    position: relative;
    display: block;
    overflow: hidden;
  }

  #carbonads .carbon-img img {
    display: block;
    width: 100%;
    max-width: 100% !important;
    height: auto;
  }

  #carbonads .carbon-text {
    display: block;
    padding: 6px;
    line-height: 1.2;
  }

  #carbonads .carbon-poweredby {
    display: block;
    padding: 4px;
    border-radius: 4px;
    background: rgb(128 128 128 / 0.15);
    text-align: center;
    font-size: 8px;
    letter-spacing: 0.5px;
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>("[data-carbon]")
  const slot = card?.querySelector("[data-carbon-slot]")
  const footer = document.querySelector("footer")

  // display: none below the width the card needs, so those visitors never load it
  if (card && slot && footer && getComputedStyle(card).display !== "none") {
    let loaded = false
    let footerVisible = false
    const update = () => card.toggleAttribute("data-visible", loaded && footerVisible)

    const load = () => {
      const script = document.createElement("script")
      script.src = "https://cdn.carbonads.com/carbon.js?serve=CW7I6K7U&placement=wwwmanishtamangcom&format=rect"
      script.id = "_carbonads_js"
      script.async = true
      script.addEventListener("load", () => {
        loaded = true
        update()
      })
      slot.append(script)
    }

    let requested = false
    new IntersectionObserver(([entry]) => {
      footerVisible = entry.isIntersecting
      if (footerVisible && !requested) {
        requested = true
        load()
      }
      update()
    }).observe(footer)
  }
</script>
