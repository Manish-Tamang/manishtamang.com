---
import { site } from "@/lib/site"
import Container from "./Container.astro"
import ThemeSwitcher from "./ThemeSwitcher.astro"
import Webring from "./Webring.astro"
import Separator from "@/components/ui/Separator.astro"

const year = new Date().getFullYear()

const badges = [
  { href: "/ai", src: "/images/badges/not-vibe-coded.gif", alt: "Not vibe coded: how I use AI" },
  { href: "/colophon", src: "/images/badges/coded-by-hand.gif", alt: "Coded by hand: how this site was made" },
  { href: "/colophon", src: "/images/badges/rounded-4px.gif", alt: "Rounded 4px" },
  { href: "https://astro.build", src: "/images/badges/made-with-astro.gif", alt: "Made with Astro" },
  { href: "https://indieweb.org", src: "/images/badges/indieweb.png", alt: "IndieWeb Camp" },
]
---

<footer class="mt-16">
  <Container>
    <Separator class="mb-6" />
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs text-muted-foreground">
          © 2023-{year} {site.name}{" · "}<a href="/feed.xml" class="decoration-current/35 decoration-1 underline-offset-[0.2em] transition-colors hover:text-heading hover:underline">RSS</a>{" · "}<a
            href={site.social.github}
            class="decoration-current/35 decoration-1 underline-offset-[0.2em] transition-colors hover:text-heading hover:underline">GitHub</a
          >
        </p>
        <!-- Desktop shows this under the sidebar instead -->
        <Webring class="mt-3 md:hidden" />
        <div class="mt-3 mb-1 flex flex-wrap gap-2.5">
          {badges.map(({ href, src, alt }) => (
            <a
              href={href}
              class="block shadow-[0_3px_0_0_var(--border-strong)] transition-[translate,box-shadow] duration-75 hover:-translate-y-px hover:shadow-[0_4px_0_0_var(--border-strong)] active:translate-y-[3px] active:shadow-none"
            >
              <img src={src} alt={alt} width="88" height="31" loading="lazy" class="block [image-rendering:pixelated]" />
            </a>
          ))}
        </div>
      </div>
      <div class="ml-auto flex flex-col items-end gap-4">
        <ThemeSwitcher />
      </div>
    </div>

    <!-- Decorative flowers, sitting flush on the bottom edge of the page. A plain <img>:
         this also renders on request-time pages, where there is no image service. -->
    <img
      src="/images/flowers-1200.webp"
      srcset="/images/flowers-480.webp 480w, /images/flowers-768.webp 768w, /images/flowers-1200.webp 1200w"
      sizes="(max-width: 768px) 100vw, 720px"
      alt=""
      width="1200"
      height="165"
      loading="lazy"
      decoding="async"
      draggable="false"
      class="pointer-events-none mt-10 h-auto w-full rounded-t-xl select-none"
    />
  </Container>
</footer>

