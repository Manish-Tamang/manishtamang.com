---
/*
 * The four reactions from the old site, under each post. One pick per visitor:
 * clicking it again takes it back, clicking another switches. Renders the
 * build-time counts; lib/client/reactions.ts loads the live ones and your pick.
 */
import { reactions, snapshotCounts, type Reaction } from "@/lib/blog/reactions"

export interface Props {
  slug: string
}

const { slug } = Astro.props
const counts = snapshotCounts(slug)

// Lucide icons; each lights up in one of the site's palette colours when picked
const meta: Record<Reaction, { label: string; tone: string; paths: string[] }> = {
  thumbs_up: {
    label: "Thumbs up",
    tone: "aria-pressed:border-blue/40 aria-pressed:bg-blue/10 aria-pressed:text-blue",
    paths: [
      "M7 10v12",
      "M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z",
    ],
  },
  heart: {
    label: "Heart",
    tone: "aria-pressed:border-pink/40 aria-pressed:bg-pink/10 aria-pressed:text-pink",
    paths: [
      "M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z",
    ],
  },
  trophy: {
    label: "Trophy",
    tone: "aria-pressed:border-orange/40 aria-pressed:bg-orange/10 aria-pressed:text-orange",
    paths: [
      "M6 9H4.5a2.5 2.5 0 0 1 0-5H6",
      "M18 9h1.5a2.5 2.5 0 0 0 0-5H18",
      "M4 22h16",
      "M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22",
      "M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22",
      "M18 2H6v7a6 6 0 0 0 12 0V2Z",
    ],
  },
  bookmark: {
    label: "Bookmark",
    tone: "aria-pressed:border-green/40 aria-pressed:bg-green/10 aria-pressed:text-green",
    paths: ["m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"],
  },
}
---

<div data-reactions={slug} class="mt-12 flex flex-wrap items-center gap-2" role="group" aria-label="Reactions">
  {reactions.map((reaction) => (
    <button
      type="button"
      data-reaction={reaction}
      aria-pressed="false"
      title={meta[reaction].label}
      class:list={[
        "group inline-flex h-8 items-center gap-1.5 rounded-full border border-border px-3 text-sm text-muted-foreground tabular-nums",
        "transition-[color,background-color,border-color,scale] hover:border-border-strong hover:text-heading active:scale-95",
        meta[reaction].tone,
      ]}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4 shrink-0 group-aria-pressed:fill-current/20"
        aria-hidden="true"
      >
        {meta[reaction].paths.map((d) => <path d={d} />)}
      </svg>
      <span class="sr-only">{meta[reaction].label}:</span>
      <span data-count>{counts[reaction].toLocaleString("en-GB")}</span>
    </button>
  ))}
  <p data-reaction-status role="status" aria-live="polite" class="text-xs text-muted-foreground"></p>
</div>

<script>
  import "@/lib/client/reactions"
</script>
