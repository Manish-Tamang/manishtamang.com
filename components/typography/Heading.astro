---
import type { HTMLAttributes } from "astro/types"

type Level = 1 | 2 | 3 | 4
type Size = "4xl" | "3xl" | "2xl" | "xl" | "lg"

export interface Props extends HTMLAttributes<"h1"> {
  level?: Level
  /** Visual size, independent of the semantic level. Defaults by level. */
  size?: Size
}

const defaultSize: Record<Level, Size> = { 1: "3xl", 2: "2xl", 3: "lg", 4: "lg" }

// Bold page titles, ultralight section headings, semibold sub-sections.
const weights: Record<Level, string> = {
  1: "font-hero",
  2: "font-section",
  3: "font-subsection",
  4: "font-subsection",
}

const { level = 2, size = defaultSize[level], class: className, ...rest } = Astro.props

const sizes: Record<Size, string> = {
  "4xl": "text-3xl sm:text-4xl",
  "3xl": "text-2xl sm:text-3xl",
  "2xl": "text-2xl",
  xl: "text-xl",
  lg: "text-lg",
}

const Tag = `h${level}` as const
---

<Tag class:list={["text-heading", weights[level], sizes[size], className]} {...rest}>
  <slot />
</Tag>
