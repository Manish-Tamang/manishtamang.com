---
/*
 * Preview with a play button. With a poster nothing loads until it's clicked;
 * without one, the browser fetches just enough to show an early frame.
 */
import type { ImageMetadata } from "astro"
import BlurImage from "@/components/ui/BlurImage.astro"

export interface Props {
  src: string
  poster?: ImageMetadata
  label: string
  /** Shown under the video in the player. */
  caption?: string
  /** 16:9 instead of the default 1:1. */
  wide?: boolean
  /** 3:4, for portrait phone videos. */
  tall?: boolean
}

const { src, poster, label, caption, wide = false, tall = false } = Astro.props
---

<button
  type="button"
  data-video-open={src}
  data-video-label={label}
  data-video-caption={caption}
  aria-label={`Play video: ${label}`}
  class:list={["group relative block w-full cursor-pointer overflow-hidden rounded-md bg-black", wide ? "aspect-video" : tall ? "aspect-[3/4]" : "aspect-square"]}
>
  {poster ? (
    <BlurImage src={poster} alt="" width={480} height={480} quality={80} format="webp" class="size-full object-cover opacity-80 transition-all duration-300 group-hover:scale-105 group-hover:opacity-100" />
  ) : (
    <video src={`${src}#t=0.5`} muted playsinline preload="metadata" tabindex="-1" class="pointer-events-none size-full object-cover opacity-80 transition-all duration-300 group-hover:scale-105 group-hover:opacity-100"></video>
  )}
  <span class="absolute inset-0 flex items-center justify-center">
    <span class="flex size-11 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur-sm transition-transform duration-200 group-hover:scale-110">
      <svg viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 size-5" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5Z"></path></svg>
    </span>
  </span>
</button>
