---
/*
 * One shared player for the page, opened by any VideoThumbnail. The clip
 * plays in the site's Video.js player (components/ui/VideoPlayer.astro).
 */
import VideoPlayer from "@/components/ui/VideoPlayer.astro"
import LoaderCircle from "@/components/icons/LoaderCircle.astro"
import X from "@/components/icons/X.astro"
---

<dialog data-video-modal class="m-auto max-h-none max-w-none overflow-visible bg-transparent p-0 backdrop:bg-black/90">
  <button type="button" data-video-close aria-label="Close video" class="fixed top-4 right-4 flex size-9 cursor-pointer items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-sm transition-colors hover:bg-white/25">
    <X class="size-4" />
  </button>

  <!-- Hidden (data-pending) until the clip's size is known, so it opens once at the right shape -->
  <VideoPlayer class="video-modal__player" deferred />
  <span data-video-spinner hidden class="pointer-events-none fixed inset-0 flex items-center justify-center text-white">
    <LoaderCircle class="size-8 animate-spin" />
  </span>

  <p data-video-caption hidden class="mx-auto mt-3 max-w-[92vw] px-2 text-center text-sm text-white"></p>
</dialog>

<style is:global>
  /* As large as fits: 92% of the width or 85% of the height, whichever runs out first */
  .video-modal__player {
    width: min(92vw, 1100px, calc(85dvh * var(--ratio)));
  }

  .video-modal__player[data-pending] {
    visibility: hidden;
  }
</style>

<script>
  import "@/lib/client/video-modal"
</script>
