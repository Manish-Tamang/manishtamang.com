---
import DashIcon from "./DashIcon.astro"
import { formatKathmandu } from "@/lib/date"
import type { RecentTrack } from "@/lib/services/lastfm"

export interface Props {
  tracks: RecentTrack[]
}

const { tracks } = Astro.props

const formatTime = (timestamp?: number) =>
  timestamp ? formatKathmandu(timestamp, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) : null
---

{tracks.length > 0 ? (
  <div class="space-y-2">
    {tracks.map((track) => {
      const playedAt = formatTime(track.playedAt)
      return (
        <a href={track.songUrl ?? "#"} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 rounded-2xl bg-zinc-50/70 px-3 py-2.5 transition-all hover:bg-zinc-100/80 dark:bg-zinc-900/60 dark:hover:bg-zinc-800/60">
          {track.albumImageUrl ? (
            <img src={track.albumImageUrl} alt="" loading="lazy" class="size-11 shrink-0 rounded-lg bg-zinc-200 object-cover dark:bg-zinc-800" />
          ) : (
            <div class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-zinc-200/80 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
              <DashIcon name="Music" class="size-4" />
            </div>
          )}
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-zinc-900 group-hover:underline dark:text-zinc-100">{track.title}</p>
            <p class="truncate text-xs text-zinc-500 dark:text-zinc-400">{track.artist}{track.album ? ` · ${track.album}` : ""}</p>
          </div>
          {track.isPlaying ? (
            <span class="inline-flex shrink-0 items-center gap-1.5 text-[11px] font-semibold text-[#1DB954]">
              <span class="relative flex size-1.5">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-[#1DB954] opacity-75"></span>
                <span class="relative inline-flex size-1.5 rounded-full bg-[#1DB954]"></span>
              </span>
              Now playing
            </span>
          ) : playedAt && (
            <span class="shrink-0 text-[11px] text-zinc-500 dark:text-zinc-400">{playedAt}</span>
          )}
          <DashIcon name="ExternalLink" class="size-3.5 shrink-0 text-zinc-400" />
        </a>
      )
    })}
  </div>
) : (
  <div class="rounded-xl bg-zinc-50/70 p-4 text-sm text-zinc-600 dark:bg-zinc-900/60 dark:text-zinc-400">No recent tracks available right now.</div>
)}
