---
import type { Contribution } from "@/lib/services/github"

export interface Props {
  contributions: Contribution[]
  /** Tile colour as "r, g, b". */
  color?: string
  /** What one tile counts, for the tooltip. */
  noun?: string
  empty?: string
}

const { contributions, color = "34, 197, 94", noun = "contribution", empty = "Contribution graph is unavailable right now." } = Astro.props

const ROWS = 7
const COLUMNS = 52
const LEVELS = ["rgba(107, 114, 128, 0.125)", `rgba(${color}, 0.25)`, `rgba(${color}, 0.5)`, `rgba(${color}, 0.75)`, `rgb(${color})`]

// Full weeks, then this week up to today, so the last column ends on today
const expected = (COLUMNS - 1) * ROWS + new Date().getDay() + 1
const recent = contributions.slice(-expected)
const padding: Contribution[] = Array.from({ length: Math.max(expected - recent.length, 0) }, () => ({ date: "", count: 0, level: 0 }))
const tiles = [...padding, ...recent]
---

<div data-heatmap class="overflow-x-auto">
  {contributions.length > 0 ? (
    <div data-heatmap-grid class="grid w-max grid-flow-col grid-rows-7 gap-0.5">
      {tiles.map(({ date, count, level }) => (
        <div
          class="size-[9px] rounded-[2px]"
          style={{ backgroundColor: LEVELS[level] ?? "transparent" }}
          data-tip={date ? `${count} ${noun}${count === 1 ? "" : "s"} on ${date}` : undefined}
        ></div>
      ))}
    </div>
  ) : (
    <p class="text-sm text-muted-foreground">{empty}</p>
  )}
  <!-- One shared tooltip: fixed, so the scrolling graph can't clip it -->
  <div data-heatmap-tip hidden class="pointer-events-none fixed z-50 -translate-x-1/2 -translate-y-full rounded-sm bg-black px-2 py-1 text-[10px] whitespace-nowrap text-white"></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-heatmap]").forEach((root) => {
    const graph = root.querySelector<HTMLElement>("[data-heatmap-grid]")
    const tip = root.querySelector<HTMLElement>("[data-heatmap-tip]")
    if (!graph || !tip) return

    graph.addEventListener("pointerover", (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLElement>("[data-tip]")
      tip.hidden = !tile
      if (!tile) return

      const { left, top, width } = tile.getBoundingClientRect()
      tip.textContent = tile.dataset.tip!
      tip.style.left = `${left + width / 2}px`
      tip.style.top = `${top - 4}px`
    })
    graph.addEventListener("pointerleave", () => (tip.hidden = true))
  })
</script>
