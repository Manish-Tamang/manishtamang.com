---
/*
 * A guestbook message as safe HTML: rich text for new messages, linked URLs for
 * plain ones from before (lib/guestbook/rich-text.ts escapes everything else).
 */
import { messageHtml, richTextClass, type MessageFormat } from "@/lib/guestbook/rich-text"

export interface Props {
  text: string
  format: MessageFormat
}

const { text, format } = Astro.props
---

<span class={richTextClass} set:html={messageHtml(text, format)} />
