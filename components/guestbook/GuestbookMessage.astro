---
import { linkParts } from "@/lib/guestbook"

export interface Props {
  text: string
}

const { text } = Astro.props
---

{linkParts(text).map((part, index) =>
  index % 2 ? <a href={part} target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-4">{part}</a> : part,
)}
