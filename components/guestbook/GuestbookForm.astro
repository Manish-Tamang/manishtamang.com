---
import Button from "@/components/ui/Button.astro"
import GitHub from "@/components/icons/GitHub.astro"
import Google from "@/components/icons/Google.astro"
import ImagePlus from "@/components/icons/ImagePlus.astro"
import LoaderCircle from "@/components/icons/LoaderCircle.astro"
import SendSolid from "@/components/icons/SendSolid.astro"
import X from "@/components/icons/X.astro"
import Link2 from "@/components/icons/Link2.astro"
import { MAX_MESSAGE, richTextClass } from "@/lib/guestbook/rich-text"
import type { User } from "better-auth"
import WashFrame from "@/components/ui/WashFrame.astro"

export interface Props {
  user: User | null
}

const { user } = Astro.props

// Shortcut hints follow the platform in the script; titles show the ⌘/Ctrl form
const formats = [
  { format: "bold", label: "Bold", shortcut: "B", glyph: "B", class: "font-bold" },
  { format: "italic", label: "Italic", shortcut: "I", glyph: "I", class: "italic" },
  { format: "strike", label: "Strikethrough", shortcut: "Shift+X", glyph: "S", class: "line-through" },
  { format: "code", label: "Code", shortcut: "E", glyph: "</>", class: "font-mono text-[0.7rem]" },
]
const iconButton = "flex size-8 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-subtle hover:text-heading"
const toolButton = "flex size-7 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-heading aria-pressed:bg-foreground/5 aria-pressed:text-heading"
---

{user ? (
  <form data-guestbook-form data-user={user.id} class="rounded-lg border border-border bg-subtle p-4">
    <div class="flex gap-3">
      {user.image ? (
        <img src={user.image} alt="" width="40" height="40" referrerpolicy="no-referrer" class="size-8 shrink-0 rounded-md border border-border object-cover" />
      ) : (
        <span class="flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-muted text-xs font-subsection text-heading">{user.name?.charAt(0)}</span>
      )}
      <div class="min-w-0 flex-1 space-y-3">
        <div class="flex h-8 items-center justify-between gap-3">
          <p class="truncate text-sm text-muted-foreground">
            Signed in as <span class="font-subsection text-heading">{user.name}</span>
          </p>
          <button type="button" data-sign-out class="shrink-0 cursor-pointer text-xs text-muted-foreground transition-colors hover:text-heading">Sign out</button>
        </div>
        <div data-preview hidden class="group relative w-fit">
          <img alt="Preview" class="max-h-48 rounded-lg border border-border object-cover" />
          <button type="button" data-remove-image aria-label="Remove image" class="absolute -top-2 -right-2 cursor-pointer rounded-full bg-heading p-1 text-background shadow-sm transition-opacity group-hover:opacity-100 sm:opacity-0">
            <X class="size-3" />
          </button>
        </div>
        <div class="relative">
          <div
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-label="Message"
            data-rich-editor
            data-placeholder="Leave a message or some kudos!"
            class:list={[
              "block max-h-72 min-h-28 w-full overflow-y-auto rounded-md border border-border bg-background px-3 pt-2 pb-10 text-sm break-words whitespace-pre-wrap text-foreground",
              "transition-colors hover:border-border-strong focus-visible:border-accent focus-visible:outline-none",
              "empty:before:pointer-events-none empty:before:text-muted-foreground empty:before:content-[attr(data-placeholder)]",
              richTextClass,
            ]}
          ></div>
          <input type="hidden" name="message" maxlength={MAX_MESSAGE} />
          <!-- Formatting for the editor above (lib/client/rich-editor.ts) -->
          <div class="absolute bottom-1.5 left-1.5 flex items-center gap-0.5" role="toolbar" aria-label="Formatting">
            {formats.map(({ format, label, shortcut, glyph, class: glyphClass }) => (
              <button type="button" data-format={format} title={`${label} (Ctrl+${shortcut})`} aria-label={label} class={toolButton}>
                <span class:list={["text-sm leading-none", glyphClass]} aria-hidden="true">{glyph}</span>
              </button>
            ))}
            <button type="button" data-format="link" title="Link (Ctrl+K)" aria-label="Link" class={toolButton}>
              <Link2 class="size-3.5" />
            </button>
          </div>
          <div class="absolute right-1 bottom-1.5 flex items-center">
            <label class={iconButton}>
              <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp" class="sr-only" />
              <ImagePlus class="size-4" />
              <span class="sr-only">Add image</span>
            </label>
            <button type="submit" aria-label="Post message" title="Post (Ctrl+Enter)" class:list={[iconButton, "disabled:opacity-50"]}>
              <SendSolid data-send-icon class="size-4" />
              <LoaderCircle data-send-spinner class="hidden size-4 animate-spin" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </form>
) : (
  <WashFrame tone="sun" inner="p-4">
    <div>
      <h2 class="text-sm font-subsection text-heading">Sign the guestbook</h2>
      <p class="text-sm text-muted-foreground">Log in to leave a message and join the building of this space.</p>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-3">
      <Button variant="outline" data-sign-in="github" class="h-10 gap-2 rounded-md border-transparent bg-background text-sm hover:border-transparent"><GitHub class="size-4" /> GitHub</Button>
      <Button variant="outline" data-sign-in="google" class="h-10 gap-2 rounded-md border-transparent bg-background text-sm hover:border-transparent"><Google class="size-4" /> Google</Button>
    </div>
  </WashFrame>
)}
