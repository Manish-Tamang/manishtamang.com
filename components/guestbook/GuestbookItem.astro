---
import Badge from "@/components/ui/Badge.astro"
import Input from "@/components/ui/Input.astro"
import Heart from "@/components/icons/Heart.astro"
import Link2 from "@/components/icons/Link2.astro"
import Reply from "@/components/icons/Reply.astro"
import Send from "@/components/icons/Send.astro"
import Smile from "@/components/icons/Smile.astro"
import Trash2 from "@/components/icons/Trash2.astro"
import X from "@/components/icons/X.astro"
import GuestbookMessage from "./GuestbookMessage.astro"
import { MAX_MESSAGE } from "@/lib/guestbook/rich-text"
import { EMOJIS, timeAgo, type GuestbookEntry } from "@/lib/guestbook"

export interface Props {
  entry: GuestbookEntry
  isAdmin: boolean
}

const { entry, isAdmin } = Astro.props

const words = entry.message.split(/\s+/)
const isLong = words.length > 60
const hasReplies = Boolean(entry.replies?.length)

const reveal = "transition-opacity sm:opacity-0 sm:group-hover:opacity-100 sm:focus-visible:opacity-100"
const iconButton = "flex size-6 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-subtle"
const action = "flex cursor-pointer items-center gap-1.5 text-xs text-muted-foreground transition-colors"
const actionIcon = "size-3.5 transition-transform active:scale-125"
const avatar = "shrink-0 rounded-md border border-border bg-muted object-cover"

// The admin's like and emoji show the same way: small round badges on their avatar
const adminTitle = [entry.likedByAdmin && "Liked", entry.adminReaction && `reacted ${entry.adminReaction}`]
  .filter(Boolean)
  .join(" and ")
// Round badges with a ring in the page colour. The heart stays a small 14px dot; the
// emoji badge is 18px with a 12px emoji, so it reads next to the 20px avatar
const badge = "flex items-center justify-center rounded-full border border-background"
---

<div
  id={entry.id}
  data-entry={entry.id}
  data-name={entry.name}
  class="group relative -mx-2 flex scroll-mt-24 gap-3 rounded-lg p-2 transition-colors duration-700 target:bg-subtle target:ring-1 target:ring-border"
>
  {(entry.likedByAdmin || entry.adminReaction) && (
    <span class="absolute right-0 bottom-2 z-10" title={`${adminTitle.charAt(0).toUpperCase()}${adminTitle.slice(1)} by Manish`}>
      <span class="relative block">
        <img src="https://github.com/Manish-Tamang.png" alt="" width="20" height="20" loading="lazy" class="size-5 rounded-full border border-background object-cover" />
        <span class="absolute -right-2 -bottom-2 flex items-end -space-x-1">
          {entry.adminReaction && (
            <span class:list={[badge, "size-4.5 bg-background text-xs leading-none"]}>{entry.adminReaction}</span>
          )}
          {entry.likedByAdmin && (
            <svg viewBox="0 0 14 14" class="block size-3.5 shrink-0" aria-hidden="true">
              <circle cx="7" cy="7" r="6.5" class="fill-danger stroke-background" stroke-width="1" />
              <path
                transform="translate(3 3.25) scale(0.3333)"
                d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
                fill="white"
                stroke="white"
                stroke-width="2"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </span>
      </span>
    </span>
  )}

  <div class="flex flex-col items-center">
    <div class="relative size-8 shrink-0">
      {entry.image_url ? (
        <img src={entry.image_url} alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" class:list={[avatar, "size-full"]} />
      ) : (
        <span class:list={[avatar, "flex size-full items-center justify-center text-xs font-subsection text-heading"]}>{entry.name.charAt(0)}</span>
      )}
      <!-- Only the admin can like, so only they need the pop animation -->
      {isAdmin && <Heart data-heart-pop class="pointer-events-none absolute top-0 left-1/2 z-50 hidden size-6 -translate-x-1/2 -translate-y-8 animate-bounce fill-current text-danger" />}
    </div>
    {hasReplies && <div class="mt-2 w-px flex-1 bg-border"></div>}
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-3">
      <div class="flex min-w-0 flex-wrap items-center gap-x-2">
        <p class="text-sm font-subsection text-heading">{entry.name}</p>
        {entry.isAdminAuthor && <Badge variant="accent">Admin</Badge>}
        <time datetime={entry.timestamp} title={new Date(entry.timestamp).toUTCString()} class="text-xs text-muted-foreground tabular-nums">{timeAgo(entry.timestamp)}</time>
      </div>
      <div class:list={["-my-1 flex shrink-0 items-center", reveal]}>
        <button type="button" data-action="copy" title="Copy link to this message" aria-label="Copy link" class:list={[iconButton, "hover:text-heading"]}>
          <Link2 class="size-3.5" />
        </button>
        {(isAdmin || entry.isMine) && (
          <button type="button" data-action="delete" aria-label="Delete message" class:list={[iconButton, "hover:text-danger"]}>
            <Trash2 class="size-3.5" />
          </button>
        )}
      </div>
    </div>

    <div class="text-sm break-words whitespace-pre-wrap text-foreground">
      {isLong ? (
        <>
          <span data-short><GuestbookMessage text={`${words.slice(0, 60).join(" ")}...`} format={entry.format} /></span>
          <span data-full hidden><GuestbookMessage text={entry.message} format={entry.format} /></span>
          <button type="button" data-action="more" class="ml-1 cursor-pointer text-link transition-colors hover:text-link-hover">See more</button>
        </>
      ) : (
        <GuestbookMessage text={entry.message} format={entry.format} />
      )}
    </div>

    {entry.attachment_url && (
      <div class="mt-3 aspect-16/10 max-w-full overflow-hidden rounded-lg border border-border bg-muted sm:max-w-100">
        <img src={entry.attachment_url} alt="Attachment" loading="lazy" draggable="false" class="size-full object-cover select-none" />
      </div>
    )}

    {entry.reactions.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-1">
        {entry.reactions.map(({ emoji, count }) => (
          <span class="flex h-6 items-center gap-1 rounded-full border border-border bg-subtle px-2 text-xs text-muted-foreground tabular-nums">
            <span>{emoji}</span>
            <span>{count}</span>
          </span>
        ))}
      </div>
    )}

    {isAdmin && (
      <div class:list={["mt-2 flex items-center gap-4", reveal, "has-[details[open]]:opacity-100"]}>
        <button type="button" data-action="like" data-liked={entry.likedByMe ? "true" : undefined} class:list={[action, entry.likedByMe ? "text-danger" : "hover:text-danger"]}>
          <Heart class:list={[actionIcon, entry.likedByMe && "fill-current"]} />
          <span>{entry.likedByMe ? "Liked" : "Like"}</span>
        </button>

        <details class="relative">
          <summary class:list={[action, "list-none", entry.myReaction ? "text-heading" : "hover:text-heading"]}>
            <Smile class={actionIcon} />
            <span>React</span>
          </summary>
          <!-- w-max: sized by its buttons, not squeezed to the width of "React" -->
          <div class="absolute bottom-full left-0 z-20 mb-1.5 grid w-max grid-cols-4 gap-0.5 rounded-xl border border-border bg-background p-1 shadow-lg sm:grid-cols-8">
            {EMOJIS.map((emoji) => (
              <button
                type="button"
                data-action="react"
                data-emoji={emoji}
                aria-label={`React ${emoji}`}
                aria-pressed={String(emoji === entry.myReaction)}
                class="flex size-8 cursor-pointer items-center justify-center rounded-lg text-lg leading-none transition-[scale,background-color] hover:scale-110 hover:bg-subtle active:scale-95 aria-pressed:bg-muted"
              >
                {emoji}
              </button>
            ))}
          </div>
        </details>

        <button type="button" data-action="reply" class:list={[action, "hover:text-heading"]}>
          <Reply class={actionIcon} />
          <span>Reply</span>
        </button>
      </div>
    )}

    {isAdmin && (
      <form data-reply-form hidden class="mt-3 flex gap-2">
        <div class="relative flex-1">
          <Input name="message" placeholder="Write a reply..." aria-label="Reply" required maxlength={MAX_MESSAGE} data-rich-text class="pr-9" />
          <button type="button" data-action="cancel-reply" aria-label="Cancel reply" class="absolute top-1/2 right-3 -translate-y-1/2 cursor-pointer text-muted-foreground transition-colors hover:text-heading">
            <X class="size-3.5" />
          </button>
        </div>
        <button type="submit" class="glossy inline-flex h-10 cursor-pointer items-center gap-2 rounded-md px-4 text-sm">
          <Send class="size-3.5" />
          <span class="hidden sm:inline">Post</span>
        </button>
      </form>
    )}

    {hasReplies && (
      <div class="mt-4 space-y-4">
        {entry.replies!.map((reply) => (
          <div data-entry={reply.id} class="group/reply relative flex gap-3">
            {reply.image_url ? (
              <img src={reply.image_url} alt="" width="24" height="24" loading="lazy" referrerpolicy="no-referrer" class:list={[avatar, "size-6"]} />
            ) : (
              <span class:list={[avatar, "flex size-6 items-center justify-center text-xs font-subsection text-heading"]}>{reply.name.charAt(0)}</span>
            )}
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-3">
                <div class="flex min-w-0 flex-wrap items-center gap-x-2">
                  <p class="text-sm font-subsection text-heading">{reply.name}</p>
                  {reply.isAdminAuthor && <Badge variant="accent">Admin</Badge>}
                  <time datetime={reply.timestamp} title={new Date(reply.timestamp).toUTCString()} class="text-xs text-muted-foreground tabular-nums">{timeAgo(reply.timestamp)}</time>
                </div>
                {(isAdmin || reply.isMine) && (
                  <button type="button" data-action="delete" aria-label="Delete reply" class:list={[iconButton, "-my-1 shrink-0 hover:text-danger sm:opacity-0 sm:group-hover/reply:opacity-100 sm:focus-visible:opacity-100"]}>
                    <Trash2 class="size-3.5" />
                  </button>
                )}
              </div>
              <div class="text-sm break-words text-foreground"><GuestbookMessage text={reply.message} format={reply.format} /></div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</div>
