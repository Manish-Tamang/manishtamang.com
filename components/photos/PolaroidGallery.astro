---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import BlurImage from "@/components/ui/BlurImage.astro";
import type { Polaroid } from "@/data/about";

export interface Props {
  items: Polaroid[];
}

const { items } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "/assets/{bio,images}/*.{jpg,png}",
  { eager: true },
);
const find = (file: string) =>
  files[`/assets/bio/${file}`]?.default ??
  files[`/assets/images/${file}`]?.default;

const polaroids = await Promise.all(
  items.map(async (item) => {
    const image = find(item.file);
    if (!image) throw new Error(`Missing polaroid image: ${item.file}`);
    const full = await getImage({
      src: image,
      widths: [800, 1280, 1920],
      format: "webp",
      quality: 82,
    });
    return { ...item, image, full };
  }),
);
---

<ul
  class="mx-auto flex w-fit items-center gap-2 -space-x-4 px-4 sm:gap-4 sm:-space-x-8 sm:px-0"
  aria-label="Polaroid memories"
>
  {polaroids.map(({ image, full, caption, alt, rotate }, i) => (
    <li
      class:list={["polaroid shrink-0", i >= 3 && "max-sm:hidden"]}
      style={`--rotate: ${rotate}deg`}
    >
      <button
        type="button"
        class="block w-[28vw] cursor-zoom-in rounded-[1px] bg-white p-1.5 pb-0 sm:w-32 dark:bg-muted"
        aria-label={`Open photo: ${caption}`}
        data-photo
        data-src={full.src}
        data-srcset={full.srcSet.attribute}
        data-width={image.width}
        data-height={image.height}
        data-alt={alt}
        data-caption={caption}
        data-date=""
      >
        <BlurImage
          src={image}
          alt={alt}
          width={256}
          widths={[128, 192, 256]}
          sizes="(max-width: 640px) 28vw, 128px"
          quality={70}
          draggable="false"
          class="aspect-square w-full bg-zinc-100 object-cover select-none"
        />
        <span class="block font-display truncate py-1.5 text-center text-[12px] text-foreground">
          {caption}
        </span>
      </button>
    </li>
  ))}
</ul>

<style>
  .polaroid {
    position: relative;
    transform: rotate(var(--rotate));

    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .polaroid button {
    box-shadow:
      rgb(14 63 126 / 0.06) 0 0 0 1px,
      rgb(42 51 70 / 0.03) 0 1px 1px -0.5px,
      rgb(42 51 70 / 0.04) 0 2px 2px -1px,
      rgb(42 51 70 / 0.04) 0 3px 3px -1.5px,
      rgb(42 51 70 / 0.03) 0 5px 5px -2.5px,
      rgb(42 51 70 / 0.03) 0 10px 10px -5px,
      rgb(42 51 70 / 0.03) 0 24px 24px -8px;
  }

  :global(.dark) .polaroid button {
    box-shadow:
      rgb(0 0 0 / 0.5) 0 0 0 1px,
      rgb(0 0 0 / 0.4) 0 1px 1px -0.5px,
      rgb(0 0 0 / 0.3) 0 2px 2px -1px,
      rgb(0 0 0 / 0.3) 0 3px 3px -1.5px,
      rgb(0 0 0 / 0.25) 0 5px 5px -2.5px,
      rgb(0 0 0 / 0.2) 0 10px 10px -5px,
      rgb(0 0 0 / 0.15) 0 24px 24px -8px;
  }

  .polaroid:hover,
  .polaroid:focus-within {
    transform: rotate(0deg) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid {
      transition: none;
    }
  }
</style>
