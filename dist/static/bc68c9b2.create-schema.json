        "name": "excerpt",
        "type": "string"
      },
      {
        "options": {
          "hotspot": true
        },
        "description": "The featured image for the post, displayed at the top or in previews",
        "name": "coverImage",
        "type": "image"
      },
      {
        "description": "The publication date and time of the post",
        "name": "date",
        "type": "datetime"
