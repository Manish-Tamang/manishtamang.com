        "type": "string"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              }
            ],
            "level": "error"
          }
        ],
        "description": "A URL-friendly version of the title, used in the post URL",
        "name": "slug",
        "type": "slug"
      },
      {
        "description": "The main body content of the post, written in Markdown format",
        "name": "content",
        "type": "markdown"
      },
      {
