---
import PageLayout from "@/layouts/PageLayout.astro"
import BlogListItem from "@/components/blog/BlogListItem.astro"
import SearchableList from "@/components/shared/SearchableList.astro"
import YearGroup from "@/components/shared/YearGroup.astro"
import Rss from "@/components/icons/Rss.astro"
import Link from "@/components/ui/Link.astro"
import { getPosts } from "@/lib/blog"

const posts = await getPosts()
const years = [...new Set(posts.map(({ data }) => data.date.getUTCFullYear()))]
---

<PageLayout
  column
  heading="Blog"
  description="Articles and notes by Manish Tamang (golecodes) on web development and design."
>
  <Fragment slot="intro">
    I've been writing online since 2023, mostly about web development, blogging and tech. Use the search below to filter
    by title, or follow along with the <Link href="/feed.xml"
      ><Rss class="mr-1 inline-block size-3.5 align-[-2px]" />RSS feed</Link
    >.
  </Fragment>

  <SearchableList noun="posts" views>
    {years.map((year) => (
      <YearGroup year={year}>
        {posts
          .filter(({ data }) => data.date.getUTCFullYear() === year)
          .map((post) => <BlogListItem post={post} />)}
      </YearGroup>
    ))}
  </SearchableList>
</PageLayout>
