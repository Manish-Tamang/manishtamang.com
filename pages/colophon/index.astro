---
/*
 * In StoryLayout, with the same rhythm as /about and /uses: the intro as a 24px
 * lead, the story in the shared 14/22 prose, and body-size section titles.
 */
import { getCollection } from "astro:content"
import StoryLayout from "@/layouts/StoryLayout.astro"
import Prose from "@/components/typography/Prose.astro"
import Link from "@/components/ui/Link.astro"
import ToolItem from "@/components/uses/ToolItem.astro"
import GitHub from "@/components/icons/GitHub.astro"
import ColorStrip from "@/components/colophon/ColorStrip.astro"
import { designCredits, fonts, inspirations, launchDate, palette, services, stack } from "@/data/colophon"
import { slashPages } from "@/data/slash-pages"
import { staticPages } from "@/lib/routes"
import { getPosts } from "@/lib/blog"
import WashFrame from "@/components/ui/WashFrame.astro"

const daysLive = (since: string, now = new Date()) =>
  Math.floor((now.getTime() - new Date(`${since}T00:00:00Z`).getTime()) / 86_400_000)
const live = daysLive(launchDate)

const postCount = (await getPosts()).length
const projectCount = (await getCollection("projects")).length
const pageCount = staticPages.length + postCount + projectCount + slashPages.length

// Star count at build time; the line is left out if GitHub doesn't answer
let stars: number | null = null
try {
  const response = await fetch("https://api.github.com/repos/Manish-Tamang/manishtamang.com", {
    headers: { accept: "application/vnd.github+json" },
  })
  if (response.ok) stars = (await response.json()).stargazers_count ?? null
} catch {}

const section = "mt-8"
const sectionTitle = "mb-3 text-sm font-subsection text-heading"
const sectionIntro = "-mt-1 mb-4 text-sm text-muted-foreground"
// ToolItem rows pad 8px top and bottom; pulling the list up 8px keeps the 12px title gap
const toolGrid = "-mt-2 grid gap-x-6 sm:grid-cols-2"
---

<StoryLayout heading="Colophon" description="How manishtamang.com is made: the stack, typography, colours and the people whose work shaped it.">
  <p class="font-lead text-lead text-heading">How this website is made, and the people whose work shaped it.</p>

  <section class="mt-4">
    <h2 class="sr-only">About this website</h2>
    <Prose class="prose-story">
      <p>
        This website is my personal portfolio, my place on the internet. It's a digital canvas where I show my skills,
        projects, and everything I'm passionate about.
      </p>
      <p>
        My journey began in 2023 when I deployed my first portfolio, which I had copied from a{" "}
        <a href="https://www.youtube.com/watch?v=ldwlOzRvYOU" target="_blank" rel="noopener noreferrer">YouTube</a> tutorial.
        After passing my SEE examination, I built the second version, heavily inspired by{" "}
        <a href="https://leerob.com/" target="_blank" rel="noopener noreferrer">Leerob's</a> portfolio. In March 2025 I
        launched the third version, and the fourth was crafted from the ground up with a strong focus on minimalism.
      </p>
      <p>
        This is the fifth version, rebuilt in Astro. Pages ship as plain HTML with almost no JavaScript, and all the
        writing, photos and data live in the repository instead of a CMS.
      </p>
    </Prose>

    <WashFrame class="mt-6" inner="flex flex-wrap items-end gap-x-8 gap-y-6 p-5">
      <dl class="flex items-end divide-x divide-border">
        <div class="pr-8">
          <dt class="text-xs text-muted-foreground">Live since Apr 12, 2023</dt>
          <dd class="mt-1 flex items-baseline gap-1.5">
            <span class="text-3xl font-semibold tracking-tight text-heading tabular-nums" data-site-age data-since={launchDate}>
              {live.toLocaleString("en-GB")}
            </span>
            <span class="text-sm text-muted-foreground">days</span>
          </dd>
        </div>
        <div class="pl-8">
          <dt class="text-xs text-muted-foreground">{postCount} posts · {projectCount} projects</dt>
          <dd class="mt-1 flex items-baseline gap-1.5">
            <span class="text-3xl font-semibold tracking-tight text-heading tabular-nums">{pageCount}</span>
            <span class="text-sm text-muted-foreground">pages</span>
          </dd>
        </div>
      </dl>

      <a
        href="https://github.com/Manish-Tamang/manishtamang.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex h-8 items-stretch overflow-hidden rounded-md border border-border text-xs font-medium text-heading shadow-[0_1px_0_rgb(31_35_40/0.04)] sm:ml-auto"
        aria-label={stars !== null ? `Star manishtamang.com on GitHub, ${stars} stars` : "manishtamang.com on GitHub"}
      >
        <span class="inline-flex items-center gap-1.5 bg-subtle px-3 transition-colors group-hover:bg-muted">
          <GitHub class="size-4" />
          <svg viewBox="0 0 16 16" class="size-3.5 text-muted-foreground" fill="currentColor" aria-hidden="true">
            <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
          </svg>
          {stars !== null ? "Star" : "Source"}
        </span>
        {stars !== null && (
          <span class="inline-flex items-center border-l border-border bg-background px-3 tabular-nums transition-colors group-hover:text-link">
            {stars.toLocaleString("en-GB")}
          </span>
        )}
      </a>
    </WashFrame>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Built with</h2>
    <ul class={toolGrid}>
      {stack.map((tool) => <li><ToolItem {...tool} /></li>)}
    </ul>
    <p class="mt-3 text-sm text-muted-foreground">
      The code is open source on <Link href="https://github.com/Manish-Tamang/manishtamang.com">GitHub</Link>.
    </p>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Typography</h2>
    <ul class="grid gap-4 sm:grid-cols-3">
      {fonts.map(({ name, role, url, class: fontClass }) => (
        <li>
          <div
            class:list={[
              "flex h-20 items-center justify-center rounded-xl border border-border bg-subtle px-3 text-center text-xl whitespace-nowrap text-heading transition-colors hover:bg-muted sm:h-24",
              fontClass,
            ]}
          >
            {name}
          </div>
          <p class="mt-2 text-sm">
            {url ? <Link href={url}>{name}</Link> : <span class="text-heading">{name}</span>}
            <span class="block text-xs text-muted-foreground">{role}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Colours</h2>
    <p class={sectionIntro}>
      A quiet, green-tinted grey base with one purple accent and a yellow highlighter. Light and dark themes share the
      same accents. Hover a colour to see its hex, click to copy it.
    </p>
    <div class="grid gap-6 sm:grid-cols-2">
      {[
        { label: "Accents", swatches: palette.accents },
        { label: "Neutrals", swatches: palette.neutrals },
      ].map(({ label, swatches }) => (
        <div>
          <p class="text-xs text-muted-foreground">{label}</p>
          <ColorStrip label={label} swatches={swatches} />
          <ul class="mt-4 space-y-0.5 text-xs text-muted-foreground">
            {swatches.map(({ name, hex, use }) => (
              <li class="flex items-center gap-2">
                <span class="size-2.5 shrink-0 rounded-sm ring-1 ring-black/10 ring-inset" style={`background: ${hex}`}></span>
                <span class="text-heading">{name}</span>
                <span class="font-mono uppercase">{hex}</span>
                <span class="truncate">· {use}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>APIs</h2>
    <ul class={toolGrid}>
      {services.map((tool) => <li><ToolItem {...tool} /></li>)}
    </ul>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Acknowledgements</h2>
    <p class="text-sm">
      Thanks to{" "}
      {designCredits.map(({ name, url, thanks }, i) => (
        <>
          <Link href={url}>{name}</Link> for {thanks}
          {i < designCredits.length - 2 ? ", " : i === designCredits.length - 2 ? ", and " : "."}
        </>
      ))}
    </p>

    <p class="mt-4 text-sm">
      And the people whose sites inspired the design and development of this one:{" "}
      {inspirations.map(({ name, url }, i) => (
        <>
          <Link href={url}>{name}</Link>
          {i < inspirations.length - 2 ? ", " : i === inspirations.length - 2 ? ", and " : "."}
        </>
      ))}
    </p>
    <p class="mt-4 text-sm text-muted-foreground">
      And to many more talented developers and designers whose work has unknowingly shaped my approach. Thank you all.
    </p>
  </section>
</StoryLayout>

<script>
  // Keep the day count current between deploys (same maths as the frontmatter)
  const ageEl = document.querySelector<HTMLElement>("[data-site-age]")
  if (ageEl?.dataset.since) {
    const days = Math.floor((Date.now() - new Date(`${ageEl.dataset.since}T00:00:00Z`).getTime()) / 86_400_000)
    ageEl.textContent = days.toLocaleString("en-GB")
  }

</script>

