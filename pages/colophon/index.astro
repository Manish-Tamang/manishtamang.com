---
/*
 * In StoryLayout, with the same rhythm as /about and /uses: the intro as a 24px
 * lead, the story in the shared 14/22 prose, and body-size section titles.
 */
import { getCollection } from "astro:content"
import StoryLayout from "@/layouts/StoryLayout.astro"
import Prose from "@/components/typography/Prose.astro"
import Link from "@/components/ui/Link.astro"
import ToolItem from "@/components/uses/ToolItem.astro"
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro"
import { designCredits, fonts, inspirations, launchDate, palette, services, stack } from "@/data/colophon"
import { slashPages } from "@/data/slash-pages"
import { staticPages } from "@/lib/routes"
import { getPosts } from "@/lib/blog"

// Site age as whole years plus the days since the last anniversary
function age(since: string, now = new Date()) {
  const start = new Date(`${since}T00:00:00Z`)
  let years = now.getUTCFullYear() - start.getUTCFullYear()
  const anniversary = new Date(start)
  anniversary.setUTCFullYear(start.getUTCFullYear() + years)
  if (anniversary > now) anniversary.setUTCFullYear(start.getUTCFullYear() + --years)
  return { years, days: Math.floor((now.getTime() - anniversary.getTime()) / 86_400_000) }
}
const live = age(launchDate)

const postCount = (await getPosts()).length
const projectCount = (await getCollection("projects")).length
const pageCount = staticPages.length + postCount + projectCount + slashPages.length

// Star count at build time; the line is left out if GitHub doesn't answer
let stars: number | null = null
try {
  const response = await fetch("https://api.github.com/repos/Manish-Tamang/manishtamang.com", {
    headers: { accept: "application/vnd.github+json" },
  })
  if (response.ok) stars = (await response.json()).stargazers_count ?? null
} catch {}

const section = "mt-8"
const sectionTitle = "mb-3 text-sm font-subsection text-heading"
const sectionIntro = "-mt-1 mb-4 text-sm text-muted-foreground"
// ToolItem rows pad 8px top and bottom; pulling the list up 8px keeps the 12px title gap
const toolGrid = "-mt-2 grid gap-x-6 sm:grid-cols-2"
---

<StoryLayout heading="Colophon" description="How manishtamang.com is made: the stack, typography, colours and the people whose work shaped it.">
  <p class="font-lead text-lead text-heading">How this website is made, and the people whose work shaped it.</p>

  <section class="mt-4">
    <h2 class="sr-only">About this website</h2>
    <Prose class="prose-story">
      <p>
        This website is my personal portfolio, my place on the internet. It's a digital canvas where I show my skills,
        projects, and everything I'm passionate about.
      </p>
      <p>
        My journey began in 2023 when I deployed my first portfolio, which I had copied from a{" "}
        <a href="https://www.youtube.com/watch?v=ldwlOzRvYOU" target="_blank" rel="noopener noreferrer">YouTube</a> tutorial.
        After passing my SEE examination, I built the second version, heavily inspired by{" "}
        <a href="https://leerob.com/" target="_blank" rel="noopener noreferrer">Leerob's</a> portfolio. In March 2025 I
        launched the third version, and the fourth was crafted from the ground up with a strong focus on minimalism.
      </p>
      <p>
        This is the fifth version, rebuilt in Astro. Pages ship as plain HTML with almost no JavaScript, and all the
        writing, photos and data live in the repository instead of a CMS.
      </p>
    </Prose>

    <!-- Stat cards: colours from the old site's palette -->
    <ul class="mt-6 grid gap-3 sm:grid-cols-3">
      <li class="stat bg-[#FF6F4C]">
        <p class="stat-label">Live for</p>
        <p class="stat-value" data-site-age data-since={launchDate}>
          {live.years}<span class="stat-unit">y</span> {live.days}<span class="stat-unit">d</span>
        </p>
        <p class="stat-note">since Apr 12, 2023</p>
      </li>
      <li class="stat bg-[#84A1F0]">
        <p class="stat-label">Pages</p>
        <p class="stat-value">{pageCount}</p>
        <p class="stat-note">{postCount} posts · {projectCount} projects</p>
      </li>
      <li class="stat bg-[#3C905E]">
        <p class="stat-label">{stars !== null ? "GitHub stars" : "Source"}</p>
        <p class="stat-value">{stars !== null ? stars.toLocaleString("en-GB") : "Open"}</p>
        <p class="stat-note">
          <a href="https://github.com/Manish-Tamang/manishtamang.com" target="_blank" rel="noopener noreferrer" class="underline-offset-[0.2em] hover:underline">
            {stars !== null ? "on GitHub" : "source on GitHub"}
          </a>
        </p>
      </li>
    </ul>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Built with</h2>
    <ul class={toolGrid}>
      {stack.map((tool) => <li><ToolItem {...tool} /></li>)}
    </ul>
    <p class="mt-3 text-sm text-muted-foreground">
      The code is open source on <Link href="https://github.com/Manish-Tamang/manishtamang.com">GitHub</Link>.
    </p>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Typography</h2>
    <ul class="divide-y divide-border border-y border-border">
      {fonts.map(({ name, role, url, sample, class: fontClass }) => (
        <li class="grid gap-1 py-3 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
          <p class:list={["truncate text-xl text-heading", fontClass]}>{sample}</p>
          <p class="text-sm sm:text-right">
            {url ? <Link href={url}>{name}</Link> : <span class="text-heading">{name}</span>}
            <span class="block text-xs text-muted-foreground">{role}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Colours</h2>
    <p class={sectionIntro}>
      A quiet, green-tinted grey base with one purple accent and a yellow highlighter. Light and dark themes share the
      same accents. Click a colour to copy it.
    </p>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {palette.map(({ name, hex, use }) => (
        <li>
          <button
            type="button"
            data-copy={hex}
            class="group w-full overflow-hidden rounded-lg border border-border text-left transition-colors hover:border-border-strong"
          >
            <span class="block h-12 border-b border-border" style={`background: ${hex}`}></span>
            <span class="flex items-baseline justify-between gap-2 px-3 pt-2">
              <span class="text-sm text-heading">{name}</span>
              <span class="font-mono text-xs text-muted-foreground uppercase" data-copy-label>{hex}</span>
            </span>
            <span class="block px-3 pb-2 text-xs text-muted-foreground">{use}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>APIs</h2>
    <ul class={toolGrid}>
      {services.map((tool) => <li><ToolItem {...tool} /></li>)}
    </ul>
  </section>

  <section class={section}>
    <h2 class={sectionTitle}>Acknowledgements</h2>
    <p class={sectionIntro}>Design ideas I borrowed, with thanks:</p>
    <ul class="divide-y divide-border border-y border-border">
      {designCredits.map(({ name, url, note }) => (
        <li>
          <a href={url} target="_blank" rel="noopener noreferrer" class="group flex items-baseline justify-between gap-4 py-2.5 text-sm">
            <span class="text-heading transition-colors group-hover:text-link-hover">{name}</span>
            <span class="flex items-center gap-1 text-right text-muted-foreground">
              {note}
              <ArrowUpRight class="size-3 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-6 mb-2 text-sm text-muted-foreground">And the people whose sites inspired the design and development of this one:</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {inspirations.map(({ name, url }) => (
        <li><Link href={url}>{name}</Link></li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-muted-foreground">
      And to many more talented developers and designers whose work has unknowingly shaped my approach. Thank you all.
    </p>
  </section>
</StoryLayout>

<script>
  // Keep the site age current between deploys (same maths as the frontmatter)
  const ageEl = document.querySelector<HTMLElement>("[data-site-age]")
  if (ageEl?.dataset.since) {
    const start = new Date(`${ageEl.dataset.since}T00:00:00Z`)
    const now = new Date()
    let years = now.getUTCFullYear() - start.getUTCFullYear()
    const anniversary = new Date(start)
    anniversary.setUTCFullYear(start.getUTCFullYear() + years)
    if (anniversary > now) anniversary.setUTCFullYear(start.getUTCFullYear() + --years)
    const days = Math.floor((now.getTime() - anniversary.getTime()) / 86_400_000)
    ageEl.innerHTML = `${years}<span class="stat-unit">y</span> ${days}<span class="stat-unit">d</span>`
  }

  for (const button of document.querySelectorAll<HTMLElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const label = button.querySelector<HTMLElement>("[data-copy-label]")!
      try {
        await navigator.clipboard.writeText(button.dataset.copy!)
        label.textContent = "Copied"
        setTimeout(() => (label.textContent = button.dataset.copy!), 1200)
      } catch {}
    })
  }
</script>

<style>
  .stat {
    border-radius: var(--radius-lg);
    padding: 1rem;
    color: #fff;
  }

  .stat-label {
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    font-weight: var(--font-weight-subsection);
    opacity: 0.9;
  }

  .stat-value {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-value :global(.stat-unit) {
    margin-left: 0.15em;
    margin-right: 0.1em;
    font-size: 0.5em;
    font-weight: 500;
  }

  .stat-note {
    margin-top: 0.5rem;
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    opacity: 0.95;
  }
</style>
