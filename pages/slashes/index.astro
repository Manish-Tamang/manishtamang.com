---
import PageLayout from "@/layouts/PageLayout.astro"
import Prose from "@/components/typography/Prose.astro"
import Link from "@/components/ui/Link.astro"
import { otherSlashPages, slashPages } from "@/data/slash-pages"

const pages = [...slashPages.filter(({ href }) => href !== "/slashes"), ...otherSlashPages].sort((a, b) =>
  a.href.localeCompare(b.href),
)
---

<PageLayout
  heading="Slashes"
  intro="An index of all my slash pages."
  description="An index of all of Manish Tamang's slash pages, from /now and /uses to /nope and /verify."
>
  <Prose class="max-w-none">
    <p>
      This is a /slashes page. A /slashes page is an index of all my slash pages.{" "}
      <a href="https://slashpages.net" target="_blank" rel="noopener noreferrer">Slash pages</a> are common pages you can
      add to your website, usually with a standard, root-level slug like /now, /about, or /uses. They tend to describe
      the individual behind the site and are distinguishing characteristics of the IndieWeb.
    </p>
  </Prose>

  <ul class="mt-8 space-y-3">
    {pages.map(({ href, description }) => (
      <li class="flex flex-col sm:flex-row sm:gap-4">
        <Link href={href} class="shrink-0 sm:w-32">{href}</Link>
        <p class="text-muted-foreground">{description}</p>
      </li>
    ))}
  </ul>
</PageLayout>
