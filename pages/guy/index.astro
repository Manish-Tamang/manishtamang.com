---
import StoryLayout from "@/layouts/StoryLayout.astro"
import Link from "@/components/ui/Link.astro"
import { guy } from "@/data/slash-pages"

const article = (word: string) => (/^[aeiou]/i.test(word) ? "an" : "a")
---

<!-- In StoryLayout, with the same rhythm as /colophon and /now: a 24px lead, then 14/22 text -->
<StoryLayout heading="Guy" description="The things Manish Tamang is a guy for, in no particular order.">
  <p class="font-lead text-lead text-heading">The things I'm a guy for, in no particular order.</p>

  <ul class="mt-8 space-y-2">
    {guy.map(({ thing, ending = "guy.", tooltip }) => (
      <li>
        <p class="text-sm text-heading">
          I'm {article(thing)}{" "}
          {tooltip ? (
            <span class="group relative inline-block cursor-help" tabindex="0">
              <mark>{thing}</mark>
              <span class="pointer-events-none absolute bottom-full left-1/2 mb-1 -translate-x-1/2 rounded-sm bg-black px-2 py-1 text-xs font-normal whitespace-nowrap text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus:opacity-100" role="tooltip">{tooltip}</span>
            </span>
          ) : (
            <mark>{thing}</mark>
          )}{" "}{ending}
        </p>
      </li>
    ))}
  </ul>

  <Fragment slot="note">
    <Link href="https://canion.blog/guy/">Andrew Canion</Link> coined /guy in the IndieWeb.
  </Fragment>
</StoryLayout>
