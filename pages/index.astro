---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Container from "@/components/layout/Container.astro"
import AboutSection from "@/components/home/about/AboutSection.astro"
import FeaturedPhoto from "@/components/home/featured-photo/FeaturedPhoto.astro"
import FeaturedProjects from "@/components/home/featured-projects/FeaturedProjects.astro"
import Hero from "@/components/home/hero/Hero.astro"
import LatestPosts from "@/components/home/latest-posts/LatestPosts.astro"
import Quote from "@/components/home/quote/Quote.astro"
import TrustedBy from "@/components/home/trusted-by/TrustedBy.astro"
import { toJsonLd, websiteJsonLd } from "@/lib/seo"
import { mobileArt, mobileMedia, mobileSizes } from "@/components/home/about/mini-gole"
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={toJsonLd(websiteJsonLd)} />
  <!-- Phones: start the LCP photo with the page instead of when the parser reaches it -->
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    media={mobileMedia}
    imagesrcset={mobileArt.srcSet.attribute}
    imagesizes={mobileSizes}
    fetchpriority="high"
  />

  <Container class="pt-10 md:pt-16">
    <Hero />
  </Container>

  <Container class="relative mt-24">
    <AboutSection />
  </Container>

  <Container class="mt-24 space-y-24">
    <TrustedBy />
    <FeaturedProjects />
    <LatestPosts />
    <Quote />
    <FeaturedPhoto />
  </Container>
</BaseLayout>
