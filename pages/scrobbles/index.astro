---
import PageLayout from "@/layouts/PageLayout.astro"
import ScrobbleReport from "@/components/scrobbles/ScrobbleReport.astro"

const skeleton = "animate-pulse rounded-lg bg-muted"
---

<PageLayout
  heading="Scrobbles"
  intro="What I listened to last week, scrobbled to Last.fm."
  description="Manish Tamang's weekly listening report from Last.fm: scrobbles, top artists, albums, tracks, tags, decades and listening clock."
>
  <ScrobbleReport server:defer>
    <div slot="fallback" class="space-y-14" aria-busy="true">
      <div class="space-y-5">
        <div class:list={[skeleton, "h-14 w-64"]} />
        <div class:list={[skeleton, "h-40"]} />
      </div>
      <div class:list={[skeleton, "h-72"]} />
      <div class:list={[skeleton, "h-72"]} />
      <div class:list={[skeleton, "h-72"]} />
    </div>
  </ScrobbleReport>
</PageLayout>

<style is:global>
  /* Chart colours: this week in blue, last week in a recessive grey, and five
     categorical hues (validated for colour-blind separation) for the tag lines. */
  .scrobbles {
    --viz-now: #2a78d6;
    --viz-prev: #c9cfcf;
    --viz-1: #2a78d6;
    --viz-2: #eb6834;
    --viz-3: #1baf7a;
    --viz-4: #eda100;
    --viz-5: #e87ba4;
  }
  .dark .scrobbles {
    --viz-now: #3987e5;
    --viz-prev: #555555;
    --viz-1: #3987e5;
    --viz-2: #d95926;
    --viz-3: #199e70;
    --viz-4: #c98500;
    --viz-5: #d55181;
  }
</style>

<script>
  // Delegated: the report arrives in a server island, after the script runs
  const tip = () => document.querySelector<HTMLElement>("[data-scrobble-tip]")

  document.addEventListener("pointerover", (event) => {
    const el = tip()
    if (!el) return
    const mark = (event.target as Element).closest<Element>("[data-scrobbles] [data-tip]")
    el.hidden = !mark
    if (!mark) return

    const { left, top, width } = mark.getBoundingClientRect()
    el.textContent = mark.getAttribute("data-tip")
    el.style.left = `${left + width / 2}px`
    el.style.top = `${top - 6}px`
  })
  window.addEventListener("scroll", () => tip()?.setAttribute("hidden", ""), { passive: true })
</script>
