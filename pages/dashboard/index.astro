---
import PageLayout from "@/layouts/PageLayout.astro"
import Link from "@/components/ui/Link.astro"
import BlogStats from "@/components/dashboard/BlogStats.astro"
import CodingStats from "@/components/dashboard/CodingStats.astro"
import ContributionGraph from "@/components/dashboard/ContributionGraph.astro"
import DailyBookmarks from "@/components/dashboard/DailyBookmarks.astro"
import DashboardSection from "@/components/dashboard/DashboardSection.astro"
import RecentlyListened from "@/components/dashboard/RecentlyListened.astro"
import SiteTraffic from "@/components/dashboard/SiteTraffic.astro"
import TopMusic from "@/components/dashboard/TopMusic.astro"
import { getDashboardData } from "@/lib/dashboard"

// Rendered on request. The CDN refreshes it in the background, so visitors get a stored copy
// straight away instead of waiting on six APIs, even if nobody has visited for hours.
export const prerender = false
Astro.response.headers.set("cache-control", "public, s-maxage=60, stale-while-revalidate=86400")

const { wakatime, totals, sessions, bookmarks, tracks, topArtists, topAlbums, contributions, reading, coding, views, reactions } = await getDashboardData(Astro.url)
---

<PageLayout heading="Dashboard" description="Live coding activity, site traffic, blog statistics and what Manish Tamang is reading and listening to.">
  <div class="space-y-12">
    <DashboardSection title="Coding Activity">
      <Fragment slot="description">
        Real-time coding statistics from <Link href="https://wakatime.com/@manishtamang">WakaTime</Link>. Tracking my
        development journey across all projects and languages.
      </Fragment>
      <CodingStats wakatime={wakatime} />
    </DashboardSection>

    <DashboardSection title="Contribution Graph">
      <Fragment slot="description">
        A quick view of my activity and open-source contribution streak on <Link href="https://github.com/Manish-Tamang">GitHub</Link>.
      </Fragment>
      <ContributionGraph contributions={contributions} />
    </DashboardSection>

    <DashboardSection title="Reading Overview">
      <Fragment slot="description">
        Articles I read each day on <Link href="https://app.daily.dev/manishtamang">daily.dev</Link>.
        {reading.streak && `Current streak ${reading.streak.current} days, longest ${reading.streak.longest}, total ${reading.streak.total}.`}
      </Fragment>
      <ContributionGraph contributions={reading.days} color="206, 61, 243" noun="read" empty="Reading graph is unavailable right now." />
    </DashboardSection>

    <DashboardSection title="Coding Overview">
      <Fragment slot="description">Hours I coded each day, from <Link href="https://wakatime.com/@manishtamang">WakaTime</Link>.</Fragment>
      <ContributionGraph contributions={coding} color="59, 130, 246" noun="hour" empty="Coding graph is unavailable right now." />
    </DashboardSection>

    <DashboardSection title="Site Traffic">
      <Fragment slot="description">
        Visitors, visits, and page views from
        <Link href="https://analytics.manishtamang.com/share/jFK5VpX2c6h2JgRg/manishtamang.com">Umami</Link> since Oct 18,
        2024. Recent sessions show the latest 3 visits.
      </Fragment>
      <SiteTraffic totals={totals} sessions={sessions} />
    </DashboardSection>

    <DashboardSection title="Blog Statistics">
      <Fragment slot="description">Views and reactions across all blog posts.</Fragment>
      <BlogStats views={views} reactions={reactions} />
    </DashboardSection>

    <DashboardSection title="Reading List">
      <Fragment slot="description">Latest articles I saved on <Link href="https://app.daily.dev/bookmarks">daily.dev</Link>.</Fragment>
      <DailyBookmarks bookmarks={bookmarks} />
    </DashboardSection>

    <DashboardSection title="Recently Listened">
      <Fragment slot="description">The last few songs I played on Spotify, via <Link href="https://www.last.fm/user/golecodes">Last.fm</Link>.</Fragment>
      <RecentlyListened tracks={tracks} />
    </DashboardSection>

    <DashboardSection title="Top Artists">
      <Fragment slot="description">Who I've played the most of all time, via <Link href="https://www.last.fm/user/golecodes">Last.fm</Link>.</Fragment>
      <TopMusic items={topArtists} empty="No top artists available right now." />
    </DashboardSection>

    <DashboardSection title="Top Albums">
      <Fragment slot="description">The albums I've played the most of all time.</Fragment>
      <TopMusic items={topAlbums} empty="No top albums available right now." />
    </DashboardSection>

    <p class="text-xs text-muted-foreground">
      This page is inspired by <Link href="https://theodorusclarence.com/statistics">Theodorus Clarence (Blog stats)</Link> and
      <Link href="https://victoreke.com/">Victor Eke (Contribution Graph)</Link>.
    </p>
  </div>
</PageLayout>
