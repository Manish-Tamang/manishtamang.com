---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BlurImage from "@/components/ui/BlurImage.astro";
import StoryLayout from "@/layouts/StoryLayout.astro";
import VideoPlayer from "@/components/ui/VideoPlayer.astro";
import Firfirey from "@/components/about/Firfirey.astro";
import Separator from "@/components/ui/Separator.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import {
  education,
  featured,
  intro,
  randomFacts,
  socials,
  work,
} from "@/data/about";
import banner from "@/assets/about/banner.jpg";

const images = import.meta.glob<{ default: ImageMetadata }>("/assets/about/*", {
  eager: true,
});
const aboutImage = (file: string) => {
  const image = images[`/assets/about/${file}`]?.default;
  if (!image) throw new Error(`Missing about image: ${file}`);
  return image;
};

const icons = import.meta.glob<{
  default: (props: Record<string, unknown>) => unknown;
}>("/assets/social/*.svg", {
  eager: true,
});
const socialIcon = (name: string) =>
  icons[`/assets/social/${name}.svg`]?.default;

const divider = "my-10";
const sectionHeader = "mb-4";
const sectionTitle = "text-sm font-subsection text-heading";
const sectionIntro = "mt-0.5 text-sm text-muted-foreground";
const datePill =
  "mt-px inline-flex h-5 w-fit shrink-0 items-center rounded-full bg-muted px-1.5 text-[11px] leading-none text-foreground tabular-nums";
const logo = "mt-0.5 size-10 shrink-0 rounded-full border border-border";
const entry = "flex gap-4";
const entryHead = "flex items-start justify-between gap-4";
const bullets = "mt-3 list-disc space-y-1.5 pl-4 marker:text-muted-foreground";
---

<StoryLayout
  heading="About"
  banner={banner}
  bannerAlt="Manish looking out over Boudhanath Stupa on a cloudy evening"
  description="Learn about Manish Gole Tamang (golecodes), developer and designer from Kathmandu, Nepal."
>
  <section>
    <p class="font-display text-lead text-heading">{intro}</p>

    <div class="mt-4 grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_auto]">
      <div class="space-y-4 text-sm">
        <p>
          Driven by a love for web development, I'm an 18-year-old full stack
          aspirant from <span class="text-heading">Kathmandu, Nepal</span>. My
          coding journey began early, and since then I've dedicated myself to
          crafting engaging web experiences using technologies like React,
          Next.js, and Tailwind CSS.
        </p>
        <p>
          I'm constantly seeking new challenges and learning opportunities to
          refine my skills.
        </p>
      </div>
      <div class="hidden sm:block sm:justify-self-end">
        <Firfirey />
      </div>
    </div>

    <ul class="mt-6 flex flex-wrap items-center gap-4" aria-label="Elsewhere">
      {socials.map(({ name, url, icon, wordmark }) => {
        const Icon = socialIcon(icon) as any;
        return (
          <li>
            <a
              href={url}
              target={url.startsWith("http") ? "_blank" : undefined}
              rel={
                url.startsWith("http") ? "me noopener noreferrer" : undefined
              }
              title={name}
              class="block text-muted-foreground transition-[color,transform] hover:scale-110 hover:text-heading"
            >
              {Icon && (
                <Icon
                  class={wordmark ? "h-6 w-auto translate-y-[3px]" : "size-5"}
                  fill="currentColor"
                  aria-hidden="true"
                />
              )}
              <span class="sr-only">{name}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <Separator class={divider} />

  <section>
    <h2 class:list={[sectionTitle, sectionHeader]}>Work</h2>
    <ul class="space-y-6">
      {work.map(
        ({ company, role, location, dates, logo: file, url, highlights }) => (
          <li class={entry}>
            <Image
              src={aboutImage(file)}
              alt=""
              width={40}
              height={40}
              densities={[1, 2]}
              class:list={[logo, "bg-white object-contain"]}
            />
            <div class="min-w-0 flex-1 text-sm">
              <div class={entryHead}>
                <a
                  href={url}
                  class="min-w-0 font-subsection text-heading transition-colors hover:text-link"
                >
                  {company}
                </a>
                <span class={datePill}>{dates}</span>
              </div>
              <p class="text-muted-foreground">
                {role} · {location}
              </p>
              <ul class={bullets}>
                {highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
              <a
                href={url}
                class="mt-3 inline-flex items-center gap-1 text-link decoration-current/35 decoration-1 underline-offset-[0.2em] hover:underline"
              >
                Read the full story
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </li>
        ),
      )}
    </ul>
  </section>

  <Separator class={divider} />

  <section>
    <h2 class:list={[sectionTitle, sectionHeader]}>Education</h2>
    <ul class="space-y-4">
      {education.map(({ institution, degree, dates, logo: file }) => (
        <li class={entry}>
          <Image
            src={aboutImage(file)}
            alt=""
            width={40}
            height={40}
            densities={[1, 2]}
            class:list={[logo, "object-cover"]}
          />
          <div class="min-w-0 flex-1 text-sm">
            <div class={entryHead}>
              <p class="min-w-0 font-subsection text-heading">{institution}</p>
              <span class={datePill}>{dates}</span>
            </div>
            <p class="text-muted-foreground">{degree}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <Separator class={divider} />

  <section>
    <header class={sectionHeader}>
      <h2 class={sectionTitle}>Featured</h2>
      <p class={sectionIntro}>
        Some of my recent media features, including an interview and a spotlight
        on my portfolio.
      </p>
    </header>
    <ul class="grid gap-x-4 gap-y-6 sm:grid-cols-3">
      {featured.map(({ title, url, source, date, image }) => (
        <li>
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block"
          >
            <span class="block aspect-video overflow-hidden rounded-lg border border-border bg-muted">
              <BlurImage
                src={aboutImage(image)}
                alt=""
                width={360}
                widths={[190, 380, 570]}
                sizes="(max-width: 640px) 100vw, 190px"
                quality={70}
                class="size-full object-cover grayscale transition duration-300 group-hover:scale-[1.03] group-hover:grayscale-0"
              />
            </span>
            <span class="mt-2 block text-sm font-subsection text-heading transition-colors group-hover:text-link-hover">
              {title}
            </span>
            <span class="flex items-center justify-between gap-2 text-xs text-muted-foreground tabular-nums">
              <span class="truncate">{source}</span>
              <span class="shrink-0">{date}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Separator class={divider} />

  <section>
    <header class={sectionHeader}>
      <h2 class={sectionTitle}>Random facts</h2>
      <p class={sectionIntro}>A few stray notes from along the way.</p>
    </header>
    <ul class="space-y-10 text-sm">
      {randomFacts.map(
        ({ title, url, summary, date, points, image, youtubeId }) => (
          <li class="fact relative pl-6">
            <div class={entryHead}>
              {url ? (
                <a
                  href={url}
                  class="min-w-0 font-subsection text-heading transition-colors hover:text-link"
                >
                  {title}
                </a>
              ) : (
                <p class="min-w-0 font-subsection text-heading">{title}</p>
              )}
              <span class={datePill}>{date}</span>
            </div>
            <p class="text-muted-foreground">{summary}</p>
            {points && (
              <ul class={bullets}>
                {points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            {image && (
              <BlurImage
                src={aboutImage(image.file)}
                alt={image.alt}
                widths={[480, 768, 1152]}
                sizes="(max-width: 768px) 100vw, 552px"
                class="mt-4 w-full rounded-lg border border-border"
                data-zoom
              />
            )}
            {youtubeId && (
              <VideoPlayer
                youtube
                src={youtubeId}
                title={title}
                poster={aboutImage(`youtube-${youtubeId}.jpg`)}
                class="mt-4 w-full"
              />
            )}
          </li>
        ),
      )}
    </ul>
  </section>
</StoryLayout>

<style>
  .fact::before {
    content: "⌘";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-muted-foreground);
    line-height: var(--text-sm--line-height);
  }
</style>
