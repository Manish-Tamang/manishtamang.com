---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import PageLayout from "@/layouts/PageLayout.astro"
import Heading from "@/components/typography/Heading.astro"
import Text from "@/components/typography/Text.astro"
import Separator from "@/components/ui/Separator.astro"
import LiteYouTube from "@/components/ui/LiteYouTube.astro"
import Firfirey from "@/components/about/Firfirey.astro"
import PolaroidGallery from "@/components/photos/PolaroidGallery.astro"
import { aboutPolaroids, education, featured, intro, randomFacts, socials, work } from "@/data/about"
import farCryDark from "@/assets/about/far-cry-3-logo-black.png"
import farCryLight from "@/assets/about/far-cry-3-logo-white.png"

const images = import.meta.glob<{ default: ImageMetadata }>("/assets/about/*", { eager: true })
const aboutImage = (file: string) => {
  const image = images[`/assets/about/${file}`]?.default
  if (!image) throw new Error(`Missing about image: ${file}`)
  return image
}

const icons = import.meta.glob<{ default: (props: Record<string, unknown>) => unknown }>("/assets/social/*.svg", {
  eager: true,
})
const socialIcon = (name: string) => icons[`/assets/social/${name}.svg`]?.default
---

<PageLayout
  heading="About"
 
  description="Learn about Manish Gole Tamang (golecodes), developer and designer from Kathmandu, Nepal."
>
  <div class="space-y-14">
    <section class="space-y-6">
      <p class="font-display text-2xl leading-snug text-heading">{intro}</p>

      <div class="grid items-center gap-8 sm:grid-cols-[1fr_auto]">
        <div class="space-y-4">
          <Text>
            Driven by a love for web development, I'm an 18-year-old full stack aspirant from{" "}
            <span class="font-display text-lg text-heading">Kathmandu, Nepal</span>. My coding journey began early, and
            since then I've dedicated myself to crafting engaging web experiences using technologies like React,
            Next.js, and Tailwind CSS.
          </Text>
          <Text>I'm constantly seeking new challenges and learning opportunities to refine my skills.</Text>
        </div>
        <div class="justify-self-center sm:justify-self-end"><Firfirey /></div>
      </div>

      <ul class="flex flex-wrap items-center gap-4" aria-label="Elsewhere">
        {socials.map(({ name, url, icon }) => {
          const Icon = socialIcon(icon) as any
          return (
            <li>
              <a
                href={url}
                target={url.startsWith("http") ? "_blank" : undefined}
                rel={url.startsWith("http") ? "me noopener noreferrer" : undefined}
                title={name}
                class="block text-muted-foreground transition-[color,transform] hover:scale-110 hover:text-heading"
              >
                {Icon && <Icon class="size-5" fill="currentColor" aria-hidden="true" />}
                <span class="sr-only">{name}</span>
              </a>
            </li>
          )
        })}
      </ul>

      <div>
        <p class="text-sm text-muted-foreground">Favourite game</p>
        <Image src={farCryDark} alt="Far Cry 3" width={144} densities={[1, 2]} draggable="false" class="mt-1 -ml-1 w-36 grayscale-50 select-none dark:hidden" />
        <Image src={farCryLight} alt="Far Cry 3" width={144} densities={[1, 2]} draggable="false" class="mt-1 -ml-1 hidden w-36 grayscale-50 select-none dark:block" />
      </div>
    </section>

    <Separator />
    <PolaroidGallery items={aboutPolaroids} />
    <Separator />

    <section>
      <Heading>Work</Heading>
      <ul class="mt-5 space-y-6">
        {work.map(({ company, role, location, dates, logo, url, highlights }) => (
          <li class="flex gap-3">
            <Image src={aboutImage(logo)} alt="" width={40} height={40} densities={[1, 2]} class="size-10 shrink-0 rounded-full border border-border bg-white object-contain" />
            <div class="min-w-0 flex-1">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <div class="min-w-0">
                  <a href={url} class="font-medium text-heading hover:text-link">{company}</a>
                  <p class="text-sm text-muted-foreground">{role} · {location}</p>
                </div>
                <span class="w-fit shrink-0 rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground tabular-nums">{dates}</span>
              </div>
              <ul class="mt-2 list-disc space-y-1 pl-4 text-sm text-foreground marker:text-muted-foreground">
                {highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
              <a href={url} class="mt-2 inline-block text-sm text-link hover:underline">Read the full story →</a>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <Separator />

    <section>
      <Heading>Education</Heading>
      <ul class="mt-5 space-y-5">
        {education.map(({ institution, degree, dates, logo }) => (
          <li class="flex items-center gap-3">
            <Image src={aboutImage(logo)} alt="" width={40} height={40} densities={[1, 2]} class="size-10 shrink-0 rounded-full border border-border object-cover" />
            <div class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <p class="font-medium text-heading">{institution}</p>
                <p class="text-sm text-muted-foreground">{degree}</p>
              </div>
              <span class="w-fit shrink-0 rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground tabular-nums">{dates}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <Separator />

    <section>
      <Heading>Featured</Heading>
      <Text tone="muted" class="mt-2">Some of my recent media features, including an interview and a spotlight on my portfolio.</Text>
      <ul class="mt-5 grid gap-4 sm:grid-cols-3">
        {featured.map(({ title, url, source, date, image }) => (
          <li>
            <a href={url} target="_blank" rel="noopener noreferrer" class="group block">
              <span class="block aspect-video overflow-hidden rounded-lg border border-border bg-muted">
                <Image
                  src={aboutImage(image)}
                  alt=""
                  width={360}
                  widths={[240, 360, 540]}
                  sizes="(max-width: 640px) 100vw, 190px"
                  quality={70}
                  class="size-full object-cover grayscale transition duration-300 group-hover:scale-[1.03] group-hover:grayscale-0"
                />
              </span>
              <span class="mt-2 block text-sm font-medium leading-snug text-heading group-hover:text-link-hover">{title}</span>
              <span class="mt-1 flex items-center justify-between gap-2 text-xs text-muted-foreground">
                <span class="truncate">{source}</span>
                <span class="shrink-0">{date}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <Separator />

    <section>
      <Heading>Random facts</Heading>
      <Text tone="muted" class="mt-2">A few stray notes from along the way.</Text>
      <div class="mt-5 space-y-6">
        {randomFacts.map(({ text, youtubeId, youtubeTitle }) => (
          <div class="space-y-3">
            <Text>{text}</Text>
            {youtubeId && <LiteYouTube id={youtubeId} title={youtubeTitle} thumbnail={aboutImage(`youtube-${youtubeId}.jpg`)} />}
          </div>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
